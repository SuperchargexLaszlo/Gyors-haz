---
import BaseLayout from './BaseLayout.astro';
import ProductSidebar from '../components/ProductSidebar.astro';
import type { Product } from '../lib/products';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: 'konnyuszerkezetes' | 'modulhaz' | 'kontenerhoz' | 'altalanos';
  featuredImage?: string;
  tags?: string[];
  author?: string;
  summary?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  featuredImage,
  tags = [],
  author = 'Gyors Ház csapata',
  summary,
} = Astro.props;

const categoryLabel: Record<string, string> = {
  konnyuszerkezetes: 'Könnyűszerkezetes',
  modulhaz: 'Modulház',
  kontenerhoz: 'Konténerház',
  altalanos: 'Általános',
};

const categoryHref: Record<string, string> = {
  konnyuszerkezetes: '/konnyuszerkezetes',
  modulhaz: '/modulhaz',
  kontenerhoz: '/kontenerhaz',
  altalanos: '/blog',
};

const sidebarKat = (category !== 'altalanos' ? category : undefined) as Product['kategoria'] | undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Gyors Ház',
    url: 'https://gyors-haz.hu',
  },
  ...(featuredImage ? { image: `https://gyors-haz.hu${featuredImage}` } : {}),
  inLanguage: 'hu',
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={featuredImage ? `https://gyors-haz.hu${featuredImage}` : undefined}
  schema={articleSchema}
  updatedDate={updatedDate ?? pubDate}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <div class="lg:grid lg:grid-cols-3 lg:gap-12">
      <!-- Bal: cikk -->
      <article class="lg:col-span-2 min-w-0">
        <!-- Kategória badge -->
        <div class="mb-4">
          <a
            href={categoryHref[category]}
            class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary hover:bg-primary/20 transition-colors"
          >
            {categoryLabel[category]}
          </a>
        </div>

        <!-- H1 -->
        <h1 class="font-sans font-extrabold text-3xl sm:text-4xl text-gray-900 leading-tight mb-4">
          {title}
        </h1>

        <!-- Meta sor -->
        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-6 pb-6 border-b border-gray-100">
          <span>
            <time datetime={pubDate.toISOString()}>
              {pubDate.toLocaleDateString('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </span>
          {updatedDate && (
            <span class="text-gray-400">
              · Frissítve: <time datetime={updatedDate.toISOString()}>
                {updatedDate.toLocaleDateString('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </span>
          )}
          <span>· {author}</span>
        </div>

        <!-- Kiemelt kép -->
        {featuredImage && (
          <div class="mb-8 overflow-hidden rounded-2xl bg-gray-100 aspect-[16/9]">
            <img
              src={featuredImage}
              alt={title}
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
              data-fallback="/images/placeholder.webp"
            />
          </div>
        )}

        <!-- "Röviden" összefoglaló doboz (featured snippet) -->
        {summary && (
          <div class="mb-8 rounded-xl border-l-4 border-primary bg-primary/5 p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Röviden</p>
            <p class="text-gray-700 leading-relaxed text-sm">{summary}</p>
          </div>
        )}

        <!-- Cikk tartalom -->
        <div class="prose prose-lg prose-headings:font-sans prose-headings:font-bold prose-a:text-primary prose-a:no-underline hover:prose-a:underline max-w-none">
          <slot />
        </div>

        <!-- Tag-ek -->
        {tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-gray-100">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó témák</p>
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </article>

      <!-- Jobb: sidebar -->
      <aside class="mt-12 lg:mt-0">
        <div class="sticky top-24">
          <ProductSidebar kategoria={sidebarKat} limit={3} />

          <div class="mt-6 rounded-xl bg-accent/10 border border-accent/20 p-5 text-center">
            <p class="font-sans font-bold text-gray-900 mb-2">Ajánlatot kérek</p>
            <p class="text-sm text-gray-600 mb-4">Kötelezettség nélkül, 1 munkanapon belül visszahívjuk.</p>
            <a
              href="/ajanlatot-kerek"
              class="block w-full rounded-lg bg-accent px-4 py-2.5 text-sm font-bold text-white hover:bg-accent-dark transition-colors"
            >
              Ajánlatot kérek →
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
