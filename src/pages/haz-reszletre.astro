---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import FaqSection from '../components/FaqSection.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getProductsByKategoria } from '../lib/products';

const ksz = await getProductsByKategoria('konnyuszerkezetes');
const mod = await getProductsByKategoria('modulhaz');
const cont = await getProductsByKategoria('kontenerhoz');

const cheapestKsz = ksz.sort((a, b) => a.ar_eur - b.ar_eur)[0];
const cheapestMod = mod.sort((a, b) => a.ar_eur - b.ar_eur)[0];
const cheapestCont = cont.sort((a, b) => a.ar_eur - b.ar_eur)[0];

const title = 'Ház Részletre és Hitelre – Könnyűszerkezetes, Modul, Konténer | gyors-haz.hu';
const description =
  'Könnyűszerkezetes ház, modulház és konténerház részletre! Bankfüggetlen tanácsadóval. 7,1 millió Ft-tól, havi részletekben is fizethető. Ajánlatot kérek!';

const faqs = [
  {
    q: 'Hitelezhetőek a könnyűszerkezetes házak?',
    a: 'Igen. Több pénzintézetnél is elérhető személyi kölcsön és jelzáloghitel, amellyel könnyűszerkezetes ház, modulház vagy konténerház vásárolható. Bankfüggetlen tanácsadónkkal megtaláljuk az Önnek legmegfelelőbb konstrukciót.',
  },
  {
    q: 'Milyen dokumentumok kellenek a hitelhez?',
    a: 'Általában szükséges: személyi igazolvány, lakcímkártya, jövedelemigazolás (munkáltatói igazolás vagy NAV jövedelemigazolás), és az ingatlanra vonatkozó dokumentumok (telek tulajdoni lapja, építési engedély vagy egyszerűsített bejelentés visszaigazolása). Bankfüggetlen tanácsadónk pontosan tájékoztatja a szükséges iratokról.',
  },
  {
    q: 'Bankfüggetlen tanácsadó mit jelent pontosan?',
    a: 'A bankfüggetlen hitelközvetítő nem kötődik egyetlen pénzintézethez sem — ezért az összes elérhető konstrukciót összehasonlítva keresi meg az Ön számára legkedvezőbb ajánlatot. Díja általában a bank által fizetett közvetítői jutalékból tevődik össze, Önnek nem kell külön díjat fizetni.',
  },
  {
    q: 'Mekkora a minimális önerő mobilháznál?',
    a: 'A legtöbb banknál a hitelösszeg 20–30%-a önerőként szükséges, tehát a 27 m²-es Árnika nettó 7 076 160 Ft-os alapáránál kb. 1,4–2,1 millió Ft saját forrás elegendő lehet. Az önerő mértéke függ a hiteltermék típusától, az ingatlan értékétől és a hitelező intézménytől. Tanácsadónk segít a legkedvezőbb önerő-konstrukció megtalálásában.',
  },
  {
    q: 'Mennyi a futamidő lehetséges maximuma?',
    a: 'Személyi kölcsönnél jellemzően 7–10 év a maximum, jelzáloghitelnél akár 20–25 év is elérhető. Hosszabb futamidő alacsonyabb havi törlesztőt jelent, de összességében több kamatot fizet. Tanácsadónkkal kiszámítjuk az Önnek optimális futamidőt.',
  },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: 'https://gyors-haz.hu/haz-reszletre',
  inLanguage: 'hu',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Főoldal', item: 'https://gyors-haz.hu' },
      { '@type': 'ListItem', position: 2, name: 'Ház részletre', item: 'https://gyors-haz.hu/haz-reszletre' },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Ház részletre' },
];
---

<BaseLayout title={title} description={description} schema={webPageSchema}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Breadcrumb items={breadcrumbItems} />

    <!-- H1 -->
    <section class="py-8 lg:py-12">
      <h1 class="font-sans font-extrabold text-3xl sm:text-4xl lg:text-5xl text-gray-900 leading-tight mb-6">
        Ház részletre és hitelre
      </h1>

      <!-- Bevezető -->
      <div class="prose prose-lg max-w-3xl text-gray-600 space-y-4">
        <p>
          A <strong>mobilház részletre</strong> vásárlása egyre több magyar família számára nyitja meg az önálló
          otthon lehetőségét. A hagyományos téglaépítésnél jóval alacsonyabb árú <strong>könnyűszerkezetes ház
          hitelre</strong> vagy modulház finanszírozása ma már számos pénzintézetnél elérhető — és bankfüggetlen
          tanácsadóink segítenek a legjobb ajánlat megtalálásában.
        </p>
        <p>
          Kínálatunkban <strong>konténerház részletre</strong>, modulház és könnyűszerkezetes ház egyaránt
          megtalálható — nettó 7 076 160 Ft-tól. Ez azt jelenti, hogy akár havi néhány tízezer forintos törlesztőrészlettel
          is megvalósítható az álomotthon, amennyiben az alapozásra és a közmű-csatlakozásra külön forrás áll
          rendelkezésre.
        </p>
        <p>
          Egy <strong>bankfüggetlen tanácsadó</strong> nem egy adott bankot képvisel, hanem az Ön érdekeit.
          Összehasonlítja a piacon elérhető összes hitelajánlatot — személyi kölcsöntől a jelzáloghitelig —,
          és segít megtalálni a legalacsonyabb THM-et, a legmegfelelőbb futamidőt, és a minimálisan szükséges önerőt.
          A közvetítői díjat általában a bank fizeti, Önnek külön kiadása nincs.
        </p>
        <p>
          A folyamat egyszerű: (1) Válassza ki a kívánt háztípust és méretet. (2) Vegye fel velünk a kapcsolatot.
          (3) Bankfüggetlen tanácsadónk felveszi Önnel a kapcsolatot és felmérjük a lehetőségeket.
          (4) Beadjuk a hitelkérelmet a legkedvezőbb banknál. (5) Megkötjük az adásvételi szerződést és
          megkezdődik a gyártás.
        </p>
      </div>
    </section>

    <!-- Hogyan működik -->
    <section class="mb-16">
      <h2 class="font-sans font-bold text-2xl text-gray-900 mb-6">Hogyan működik a finanszírozás?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          {
            szam: '1',
            cim: 'Terméket választ',
            szoveg: 'Kiválasztja az igényeinek megfelelő ház típusát és méretét kínálatunkból.',
          },
          {
            szam: '2',
            cim: 'Tanácsadás',
            szoveg: 'Bankfüggetlen tanácsadónk összehasonlítja a piaci ajánlatokat és javaslatot tesz.',
          },
          {
            szam: '3',
            cim: 'Hitelkérelem + gyártás',
            szoveg: 'A jóváhagyott hitel után megkötjük a szerződést és megkezdődik a gyártás.',
          },
        ].map((step) => (
          <div class="rounded-xl bg-primary/5 p-6 text-center">
            <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-primary font-sans font-extrabold text-xl text-white">
              {step.szam}
            </div>
            <h3 class="font-sans font-bold text-gray-900 mb-2">{step.cim}</h3>
            <p class="text-sm text-gray-600">{step.szoveg}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Termékkártyák -->
    <section class="mb-16">
      <h2 class="font-sans font-bold text-2xl text-gray-900 mb-6">
        Legkedvezőbb ajánlataink — hitelezhetőek
      </h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {cheapestKsz && <ProductCard product={cheapestKsz} />}
        {cheapestMod && <ProductCard product={cheapestMod} />}
        {cheapestCont && <ProductCard product={cheapestCont} />}
      </div>
      <p class="mt-4 text-sm text-gray-500 text-center">
        Minden termékünk hitelezhetőség szempontjából megfelel a főbb pénzintézetek feltételeinek.
      </p>
    </section>

    <!-- CTA banner -->
    <section class="mb-16 rounded-2xl bg-primary p-8 sm:p-10 text-center text-white">
      <h2 class="font-sans font-bold text-2xl sm:text-3xl mb-3">
        Ingyenes hitelezési tanácsadás
      </h2>
      <p class="text-primary-100 mb-6 max-w-xl mx-auto opacity-90">
        Bankfüggetlen tanácsadónk 1 munkanapon belül visszahív és segít megtalálni az Önnek
        legjobb finanszírozási megoldást — kötelezettség nélkül.
      </p>
      <a
        href="/kapcsolat?erdeklodes=hitel"
        class="inline-block rounded-xl bg-accent px-8 py-3.5 font-sans font-bold text-white text-base hover:bg-accent-dark transition-colors shadow-lg"
      >
        Hitelezési tanácsadást kérek →
      </a>
    </section>

    <!-- FAQ -->
    <FaqSection faqs={faqs} title="Ház részletre — gyakori kérdések" />
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
