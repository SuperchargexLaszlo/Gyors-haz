---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Melyik a Legjobb Könnyűszerkezetes Ház? – Döntési Szempontok';
const description =
  'Nincs egyetlen "legjobb" könnyűszerkezetes ház – az igényeitől függ. Bemutatjuk a döntési szempontokat: méret, ár, felszereltség.';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['konnyuszerkezetes-haz-47m2', 'konnyuszerkezetes-haz-88m2', 'konnyuszerkezetes-haz-95m2'];

const faqs = [
  {
    q: 'Melyik a legjobb könnyűszerkezetes ház?',
    a: 'Nincs egyetlen objektíven "legjobb" modell – ez az Ön igényeitől (háztartás mérete, büdzsé, telek adottságai) függ. Segítünk kiválasztani a leginkább illő modellt.',
  },
  {
    q: 'Melyik modell a legnépszerűbb?',
    a: 'A 69–95 m² közötti modellek a legnépszerűbbek, mivel jó ár-alapterület arányt kínálnak 3 fős családoknak.',
  },
  {
    q: 'Hogyan válasszak modellt?',
    a: 'Érdemes a háztartás méretét, a büdzsét és a telek adottságait együtt mérlegelni – ebben ajánlatkéréskor is segítünk.',
  },
];

const kapcsolodoKeresesek = [
  { label: 'Könnyűszerkezetes ház árak', href: '/konnyuszerkezetes-haz-arak' },
  { label: 'Ki építhet könnyűszerkezetes házat', href: '/ki-epithet-konnyuszerkezetes-hazat' },
  { label: 'Olcsó könnyűszerkezetes ház', href: '/olcso-konnyuszerkezetes-haz' },
  { label: 'Könnyűszerkezetes ház hátrányai', href: '/konnyuszerkezetes-haz-hatranyai' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes', href: '/konnyuszerkezetes' },
  { label: 'Legjobb Könnyűszerkezetes Ház' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="konnyuszerkezetes"
  tags={['legjobb', 'döntés', 'könnyűszerkezetes']}
  summary="Nincs egyetlen objektíven 'legjobb' könnyűszerkezetes ház – a megfelelő választás a háztartás méretétől, a büdzsétől és a telek adottságaitól függ. Az alábbiakban bemutatjuk a fő döntési szempontokat."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    Sokan keresik a "legjobb" könnyűszerkezetes házat, de valójában nincs egyetlen mindenkinek megfelelő
    válasz – a döntés az egyéni igényektől függ. Bemutatjuk a fő szempontokat, amelyek segítenek
    választani.
  </p>

  <h2>Mennyibe kerül egy könnyűszerkezetes ház?</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Modell</th><th>Alapterület</th><th>Ár (+ ÁFA)</th></tr>
      </thead>
      <tbody>
        <tr><td>Csillagvirág (47 m²)</td><td>47 m²</td><td>12 317 760 Ft + ÁFA</td></tr>
        <tr><td>Erika (69 m²)</td><td>69 m²</td><td>18 083 520 Ft + ÁFA</td></tr>
        <tr><td>Hanga (95 m²)</td><td>95 m²</td><td>24 897 600 Ft + ÁFA</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Ajánlott modellek</h2>

  <div class="not-prose my-6">
    <HazakGrid slugok={ajanlottSlugok} columns={3} />
  </div>

  <h2>Milyen szempontok alapján érdemes választani?</h2>

  <p>
    A "legjobb" választás a háztartás méretétől (hány szobára van szükség), a rendelkezésre álló
    büdzsétől és a telek adottságaitól (mekkora alapterület fér el, milyen a talaj) függ. A 69–95 m²
    közötti modellek a legnépszerűbbek, mivel jó ár-alapterület arányt kínálnak egy átlagos, 3 fős
    családnak, de ez nem jelenti, hogy minden helyzetben ez a legjobb választás.
  </p>

  <div class="not-prose">
    <FaqSection faqs={faqs} title="Gyakran ismételt kérdések" />
  </div>

  <h2>Teljes könnyűszerkezetes-kínálatunk</h2>

  <div class="not-prose my-6">
    <HazakGrid kategoria="konnyuszerkezetes" columns={3} />
  </div>

  <div class="not-prose my-10 text-center rounded-xl bg-primary/5 border border-primary/10 p-8">
    <p class="font-sans font-bold text-xl text-gray-900 mb-3">Segítünk kiválasztani az Önnek megfelelőt</p>
    <p class="text-gray-600 mb-5">
      Kötelezettség nélkül, 1 munkanapon belül visszahívjuk – vagy hívjon most: <strong>+36 70 777 8372</strong>
    </p>
    <a href="/kapcsolat" class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-dark transition-colors">
      Kérek személyre szabott tanácsot
    </a>
  </div>

  <div class="not-prose mt-10 pt-6 border-t border-gray-100">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó keresések</p>
    <div class="flex flex-wrap gap-2">
      {kapcsolodoKeresesek.map((item) => (
        <a href={item.href} class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
