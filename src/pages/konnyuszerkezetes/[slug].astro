---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { getProductsByKategoria, formatAr, formatKulcsrakeszAr, negyzetmeterAr } from '../../lib/products';
import type { Product } from '../../lib/products';
import PlannerCta from '../../components/PlannerCta.astro';
import House3DViewer from '../../components/House3DViewer.astro';

export const getStaticPaths = async () => {
  const products = await getProductsByKategoria('konnyuszerkezetes');
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
};

interface Props {
  product: Product;
}

const { product } = Astro.props;

const w3d = Math.round(Math.sqrt(product.meret_m2 * 1.3) * 10) / 10;
const d3d = Math.round((product.meret_m2 / w3d) * 10) / 10;

const kulcsrakeszAr = formatKulcsrakeszAr(product);
const kulcsrakeszM2Ertek = product.ar_kulcsrakesz_ft
  ? Math.round(product.ar_kulcsrakesz_ft / product.meret_m2).toLocaleString('hu-HU').split(' ').join('.').split(' ').join('.')
  : '';
const kulcsrakeszM2 = kulcsrakeszM2Ertek ? kulcsrakeszM2Ertek + ' Ft/m²' : '';

const title = `${product.nev} – Ár, Jellemzők | gyors-haz.hu`;
const description = kulcsrakeszAr
  ? `${product.nev}. Alapár ${formatAr(product)}, kulcsrakészen ${kulcsrakeszAr}. ${product.szobak} hálószoba, ${product.furdo} fürdő.`.slice(0, 160)
  : product.leiras.slice(0, 155);
const updatedDate = new Date('2026-10-14');

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes házak', href: '/konnyuszerkezetes' },
  { label: product.nev },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.nev,
  description: product.leiras,
  image: `https://gyors-haz.hu${product.kep}`,
  url: `https://gyors-haz.hu/konnyuszerkezetes/${product.slug}`,
  ...(product.ar_deviza === 'HUF' && product.ar_ft
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: 'HUF',
          lowPrice: product.ar_ft,
          highPrice: product.ar_kulcsrakesz_ft ?? product.ar_ft,
          offerCount: product.ar_kulcsrakesz_ft ? 2 : 1,
        },
      }
    : {}),
};
---

<BaseLayout title={title} description={description} schema={productSchema} updatedDate={updatedDate}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <Breadcrumb items={breadcrumbItems} />

    <div class="grid lg:grid-cols-2 gap-10 mb-12">
      <!-- Kép -->
      <div>
        <ProductGallery
          images={product.kepek?.length ? product.kepek : [product.kep]}
          productName={product.nev}
        />
      </div>

      <!-- Adatok -->
      <div>
        <p class="text-sm font-medium text-primary uppercase tracking-wider mb-2">Könnyűszerkezetes ház</p>
        <h1 class="font-sans font-extrabold text-3xl sm:text-4xl text-gray-900 mb-4">{product.nev}</h1>

        {kulcsrakeszAr ? (
          <div class="grid grid-cols-2 gap-3 mb-6">
            <div class="rounded-xl border border-gray-200 p-4">
              <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Alapár</p>
              <p class="text-xl sm:text-2xl font-bold text-primary leading-tight">{formatAr(product)}</p>
              <p class="text-xs text-gray-500 mt-1">{negyzetmeterAr(product)}</p>
            </div>
            <div class="rounded-xl border-2 border-primary/30 bg-primary/5 p-4">
              <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Kulcsrakész ár</p>
              <p class="text-xl sm:text-2xl font-bold text-primary leading-tight">{kulcsrakeszAr}</p>
              <p class="text-xs text-gray-500 mt-1">{kulcsrakeszM2}</p>
            </div>
          </div>
        ) : (
          <>
            <p class="text-3xl font-bold text-primary mb-1">{formatAr(product)}</p>
            <p class="text-sm text-gray-500 mb-6">{negyzetmeterAr(product)}</p>
          </>
        )}

        <dl class="grid grid-cols-2 gap-3 text-sm mb-6">
          <div class="bg-gray-50 rounded-lg p-3">
            <dt class="text-gray-500 mb-0.5">Alapterület</dt>
            <dd class="font-semibold text-gray-900">{product.meret_m2} m²</dd>
          </div>
          <div class="bg-gray-50 rounded-lg p-3">
            <dt class="text-gray-500 mb-0.5">Hálószobák</dt>
            <dd class="font-semibold text-gray-900">{product.szobak} db</dd>
          </div>
          <div class="bg-gray-50 rounded-lg p-3">
            <dt class="text-gray-500 mb-0.5">Fürdőszoba</dt>
            <dd class="font-semibold text-gray-900">{product.furdo} db</dd>
          </div>
          {product.terasz_m2 > 0 && (
            <div class="bg-gray-50 rounded-lg p-3">
              <dt class="text-gray-500 mb-0.5">Terasz</dt>
              <dd class="font-semibold text-gray-900">{product.terasz_m2} m²</dd>
            </div>
          )}
        </dl>

        <p class="text-gray-600 text-sm leading-relaxed mb-6">{product.leiras}</p>

        <a
          href="/ajanlatot-kerek"
          class="block w-full rounded-xl bg-accent py-3.5 text-center font-sans font-bold text-white hover:bg-accent-dark transition-colors shadow mb-3"
        >
          Ajánlatot kérek
        </a>
        <a
          href="/konnyuszerkezetes"
          class="block w-full rounded-xl border-2 border-primary py-3 text-center font-sans font-semibold text-primary hover:bg-primary hover:text-white transition-colors text-sm"
        >
          ← Összes könnyűszerkezetes ház
        </a>
      </div>
    </div>

    <!-- 3D előnézet + saját tervezés -->
    <div class="mb-12 rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/5 to-transparent p-6">
      <div class="flex items-start gap-4 mb-4">
        <span class="text-3xl">📐</span>
        <div>
          <h2 class="font-bold text-primary text-lg">
            Tervezd meg a saját alaprajzodat!
          </h2>
          <p class="text-sm text-neutral-600 mt-1 leading-relaxed">
            Nem kell megelégedned a standard alaprajzzal.
            Ingyenes tervezőnkkel megrajzolhatod saját elképzelésedet —
            szobák elrendezése, méretek, bútorok. Küldd el nekünk
            és 24 órán belül személyre szabott ajánlatot adunk rá.
          </p>
        </div>
      </div>

      <House3DViewer
        width={w3d}
        depth={d3d}
        label={product.nev}
        hasTerrace={product.terasz_m2 > 0}
        windows={Math.max(4, (product.szobak || 1) * 2)}
        doors={1}
      />

      <!-- Szín-picker -->
      <div class="mt-3 flex flex-wrap gap-3 items-center">
        <label class="flex items-center gap-2 text-sm text-neutral-600">
          <span>🎨 Külső falszín:</span>
          <input type="color" value="#F5F0E8" id="wall-color-pick"
                 class="w-8 h-8 rounded cursor-pointer border border-neutral-200" />
        </label>
        <label class="flex items-center gap-2 text-sm text-neutral-600">
          <span>🏠 Tető:</span>
          <input type="color" value="#C62828" id="roof-color-pick"
                 class="w-8 h-8 rounded cursor-pointer border border-neutral-200" />
        </label>
        <button id="apply-colors"
                class="text-xs bg-primary text-white px-3 py-1.5 rounded-lg
                       hover:bg-primary-dark transition-colors">
          Alkalmaz a 3D-n
        </button>
        <span class="text-xs text-neutral-400 ml-auto">Forgasd az egérrel</span>
      </div>

      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/alaprajz-rajzolo"
           class="inline-flex items-center gap-2 bg-accent text-white
                  px-5 py-2.5 rounded-xl font-bold text-sm
                  hover:bg-accent-dark transition-colors">
          Megnyitom a tervezőt →
        </a>
        <span class="text-xs text-neutral-400 self-center">
          Ingyenes · regisztráció nélkül · mobilon is
        </span>
      </div>
    </div>

    <script>
      document.getElementById('apply-colors')?.addEventListener('click', () => {
        const wall = (document.getElementById('wall-color-pick') as HTMLInputElement)?.value;
        const roof = (document.getElementById('roof-color-pick') as HTMLInputElement)?.value;
        window.dispatchEvent(new CustomEvent('house3dColorChange', { detail: { wall, roof } }));
      });
    </script>

    <!-- Tartalmaz / Nem tartalmaz -->
    <div class:list={['grid gap-6 mb-12', product.kulcsrakesz_tartalmaz ? 'lg:grid-cols-3 sm:grid-cols-2' : 'sm:grid-cols-2']}>
      <div class="rounded-2xl border border-green-100 bg-green-50 p-6">
        <h2 class="font-bold text-green-900 mb-3">{product.kulcsrakesz_tartalmaz ? 'Az alapár tartalmazza' : 'Az ár tartalmazza'}</h2>
        <p class="text-sm text-green-800 leading-relaxed">{product.tartalmaz}</p>
      </div>
      {product.kulcsrakesz_tartalmaz && (
        <div class="rounded-2xl border border-green-200 bg-green-50 p-6">
          <h2 class="font-bold text-green-900 mb-3">A kulcsrakész ár tartalmazza</h2>
          <p class="text-sm text-green-800 leading-relaxed">{product.kulcsrakesz_tartalmaz}</p>
        </div>
      )}
      <div class="rounded-2xl border border-red-100 bg-red-50 p-6">
        <h2 class="font-bold text-red-900 mb-3">Az árban nem szerepel</h2>
        <p class="text-sm text-red-800 leading-relaxed">{product.nem_tartalmaz}</p>
      </div>
    </div>

    <PlannerCta type="konnyuszerkezetes" product={product.nev} />

    <!-- Tervezés link -->
    <div class="rounded-2xl bg-blue-50 border border-blue-100 p-6 text-center">
      <p class="text-blue-800 font-medium mb-3">
        Szüksége van tervdokumentációra és engedélyeztetésre?
      </p>
      <a
        href="/tervezes-engedely"
        class="inline-block rounded-lg bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
      >
        Tervezési és engedélyezési díjak →
      </a>
    </div>
  </div>
</BaseLayout>
