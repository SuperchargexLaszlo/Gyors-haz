---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getProductBySlug, formatAr, formatKulcsrakeszAr } from '../../lib/products';

const p35 = await getProductBySlug('konnyuszerkezetes-haz-37m2');
const p52 = await getProductBySlug('konnyuszerkezetes-haz-47m2');

const title = 'Könnyűszerkezetes Ház 40 m² Körül – Árak és Típusok | gyors-haz.hu';
const description =
  'Könnyűszerkezetes ház 40 nm körül: 37 m² (Boglárka) és 47 m² (Csillagvirág), alapár és kulcsrakész ár. 3 rétegű ablakok, 280 cm belmagasság, hitelezhetők.';

const faqs = [
  {
    q: 'Mennyi egy 40 nm-es könnyűszerkezetes ház ára?',
    a: 'Pontosan 40 m²-es típusunk nincs. A legközelebbi a 37 m²-es Boglárka (alapár 9 696 960 Ft + ÁFA, kulcsrakészen 21 134 400 Ft + ÁFA) és a 47 m²-es Csillagvirág (alapár 12 317 760 Ft + ÁFA, kulcsrakészen 27 109 600 Ft + ÁFA).',
  },
  {
    q: 'Mi fér el egy 40 nm-es házban?',
    a: 'A 37 m²-es Boglárkában egy hálószoba, amerikai konyhás nappali és fürdőszoba van. A 47 m²-es Csillagvirágban két hálószoba, amerikai konyhás nappali és fürdőszoba.',
  },
  {
    q: 'Elég-e 40 nm egy párnak?',
    a: 'Igen, egy párnak a 37–47 m²-es alapterület elég. A Boglárkához 5 m²-es fedett terasz tartozik, a Csillagvirághoz 13 m²-es terasz kérhető. A belmagasság 280 cm. Sokan nyaralónak vagy bérbeadásra is ezeket a méreteket választják.',
  },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes házak', href: '/konnyuszerkezetes' },
  { label: '40 m² körül' },
];

const updatedDate = new Date('2026-01-01');

const compareRows = p35 && p52 ? [
  { label: 'Alapterület', a: `${p35.meret_m2} m²`, b: `${p52.meret_m2} m²` },
  { label: 'Alapár', a: formatAr(p35), b: formatAr(p52) },
  { label: 'Kulcsrakész ár', a: formatKulcsrakeszAr(p35), b: formatKulcsrakeszAr(p52) },
  { label: 'Hálószobák', a: `${p35.szobak}`, b: `${p52.szobak}` },
  { label: 'Konyha', a: p35.konyha ? 'Igen' : 'Nincs', b: p52.konyha ? 'Igen' : 'Nincs' },
  { label: 'Fürdőszoba', a: `${p35.furdo} db`, b: `${p52.furdo} db` },
  { label: 'Terasz', a: p35.terasz_m2 > 0 ? `${p35.terasz_m2} m²` : 'külön kérhető', b: p52.terasz_m2 > 0 ? `${p52.terasz_m2} m²` : 'külön kérhető' },
  { label: 'Belmagasság', a: '280 cm', b: '280 cm' },
  { label: 'Tető', a: '35°-os cserepes', b: '35°-os cserepes' },
] : [];
---

<BaseLayout title={title} description={description} updatedDate={updatedDate}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Breadcrumb items={breadcrumbItems} />

    <section class="py-8 lg:py-12">
      <h1 class="font-sans font-extrabold text-3xl sm:text-4xl text-gray-900 leading-tight mb-4">
        Könnyűszerkezetes ház 40 m² — modelljeink
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mb-10">
        Pontosan 40 m²-es modellünk nincs. A legközelebbi a <strong>37 m²-es Boglárka</strong> és a
        <strong>47 m²-es Csillagvirág</strong>, az alábbi táblázatban összehasonlíthatja őket.
      </p>

      <!-- Összehasonlító tábla -->
      {compareRows.length > 0 && (
        <section class="mb-12 overflow-x-auto">
          <h2 class="font-sans font-bold text-xl text-gray-900 mb-4">Összehasonlítás: 37 m² és 47 m²</h2>
          <table class="w-full text-sm border-collapse rounded-xl overflow-hidden shadow-sm">
            <thead>
              <tr class="bg-primary text-white">
                <th class="px-5 py-3 text-left font-semibold w-1/3">Jellemző</th>
                <th class="px-5 py-3 text-center font-semibold">{p35?.nev}</th>
                <th class="px-5 py-3 text-center font-semibold">{p52?.nev}</th>
              </tr>
            </thead>
            <tbody>
              {compareRows.map((row, i) => (
                <tr class:list={[i % 2 === 0 ? 'bg-white' : 'bg-gray-50']}>
                  <td class="px-5 py-3 font-medium text-gray-700">{row.label}</td>
                  <td class="px-5 py-3 text-center text-gray-900">{row.a}</td>
                  <td class="px-5 py-3 text-center text-gray-900">{row.b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}

      <!-- Termékek egymás mellett -->
      <section class="mb-12">
        <h2 class="font-sans font-bold text-xl text-gray-900 mb-6">Modellek részletesen</h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 max-w-2xl">
          {p35 && <ProductCard product={p35} />}
          {p52 && <ProductCard product={p52} />}
        </div>
      </section>

      <!-- Belső linkek -->
      <section class="mb-12 rounded-xl bg-gray-50 p-6">
        <h2 class="font-sans font-bold text-lg text-gray-900 mb-3">Más méretek is érdeklik?</h2>
        <div class="flex flex-wrap gap-3">
          <a href="/konnyuszerkezetes" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:border-primary hover:text-primary transition-colors">
            → Összes könnyűszerkezetes ház (27–137 m²)
          </a>
          <a href="/modulhaz" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:border-primary hover:text-primary transition-colors">
            → Modulházak (27–137 m²)
          </a>
          <a href="/haz-reszletre" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:border-primary hover:text-primary transition-colors">
            → Részletre vásárlás
          </a>
        </div>
      </section>
    </section>

    <FaqSection faqs={faqs} title="40 m² körüli könnyűszerkezetes ház — kérdések" />
  </div>
</BaseLayout>
