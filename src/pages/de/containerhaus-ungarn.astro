---
import MultilingualLayout from '../../layouts/MultilingualLayout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import MultilingualContactForm from '../../components/MultilingualContactForm.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getProductsByKategoria } from '../../lib/products';

const products = await getProductsByKategoria('kontenerhoz');

const title = 'Containerhaus Ungarn – Wohncontainer ab 12,79 Mio. HUF';
const description =
  'Containerhäuser in Ungarn: Manhattan, Beverly, Nordic Premium. Schnelle Lieferung, hohe Qualität. Kostenlos anfragen!';

const faqs = [
  {
    q: 'Wie lange dauert die Lieferung eines Containerhauses?',
    a: 'Die Fertigung im Werk dauert je nach Modell einige Wochen, anschließend erfolgt die Lieferung als komplett montierte Einheit direkt auf Ihr Grundstück. Genaue Termine stimmen wir im persönlichen Angebot mit Ihnen ab.',
  },
  {
    q: 'Ist ein Fundament notwendig?',
    a: 'Ja, jedes Containerhaus benötigt ein einfaches Punkt- oder Streifenfundament als tragfähigen Untergrund. Die Fundamentarbeiten sind nicht im Grundpreis enthalten und werden vor Ort durch einen lokalen Partner ausgeführt.',
  },
  {
    q: 'Wie gut ist die Dämmung der Containerhäuser?',
    a: 'Alle Modelle verfügen über eine durchdachte Wand-, Boden- und Dachdämmung sowie 3-fach verglaste Fenster beim Nordic Premium Modell. Damit eignen sich die Häuser auch für den ganzjährigen Aufenthalt in gemäßigtem Klima.',
  },
  {
    q: 'Eignen sich Containerhäuser zum dauerhaften Wohnen?',
    a: 'Ja. Die Modelle Manhattan, Beverly und Nordic Premium sind mit vollwertigem Bad, Elektro- und Sanitärinstallation ausgestattet und für dauerhaftes Wohnen konzipiert – nicht nur als temporäre Lösung.',
  },
];
---

<MultilingualLayout title={title} description={description} lang="de">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <h1 class="font-sans font-extrabold text-3xl sm:text-4xl lg:text-5xl text-gray-900 leading-tight mb-6">
      Containerhaus Ungarn – moderne Wohncontainer zum fairen Preis
    </h1>

    <div class="not-prose max-w-2xl mx-auto mb-10">
      <ProductGallery
        images={['/images/products/kont-nordic-1.webp','/images/products/kont-manhattan.webp','/images/products/kont-beverly.webp','/images/products/kont-beverly-l.webp','/images/products/kont-manhattan-l.webp','/images/products/kont-nordic-2.webp']}
        productName="Containerhaus Ungarn"
      />
    </div>

    <div class="prose prose-lg max-w-3xl mx-auto text-gray-600">
      <p>
        Containerhäuser aus Ungarn verbinden modernes Design mit kurzer Lieferzeit und einem attraktiven
        Preis. Unsere Modelle Manhattan, Beverly und Nordic Premium werden werkseitig komplett ausgestattet
        gefertigt – inklusive Bad, Elektro- und Sanitärinstallation – und als fertige Einheit auf Ihr
        Grundstück geliefert. Ob als Gartenhaus, Zweitwohnsitz oder dauerhaftes Zuhause: Ein Wohncontainer
        ist in wenigen Wochen bezugsfertig.
      </p>

      <h2>Unsere Containerhaus-Modelle</h2>
      <p>
        Vom kompakten Manhattan-Modell mit zwei Schlafzimmern bis zum großzügigen L-förmigen Beverly-Modell
        mit drei Schlafzimmern – jedes Modell ist auf unterschiedliche Grundstücksgrößen und
        Familienkonstellationen zugeschnitten. Das Nordic Premium Modell besticht zusätzlich mit
        Holzfassade, Innenausbau in Gipskarton und einer eigenen Terrasse.
      </p>
      <div class="not-prose grid grid-cols-1 gap-6 sm:grid-cols-2 mb-4">
        {products.map((p) => (
          <div class="rounded-xl overflow-hidden bg-white shadow-sm border border-gray-100">
            <div class="aspect-[4/3] overflow-hidden bg-gray-100">
              <img src={p.kep} alt={p.nev} loading="lazy" width="600" height="450" class="h-full w-full object-cover" />
            </div>
            <div class="p-5">
              <h3 class="font-sans font-bold text-lg text-gray-900 mb-1">{p.nev}</h3>
              <p class="text-sm text-gray-500 mb-2">{p.meret_m2} m² · {p.szobak} Zimmer</p>
              <p class="font-sans font-bold text-primary text-lg">
                {p.ar_ft?.toLocaleString('de-DE')} HUF{p.afa ? ' + MwSt' : ''}
              </p>
            </div>
          </div>
        ))}
      </div>

      <h2>Was ist im Preis enthalten?</h2>
      <p>
        Der Grundpreis umfasst die komplette Hausstruktur (255 cm Deckenhöhe, 35°-Dach), Lieferung
        innerhalb von 100 km, Montage, Bodendämmung, eine 2 m breite Terrasse, das Elektropaket
        (Sicherungen, Steckdosen, Schalter), Anschlusspunkte für Wasser und Strom sowie ein komplettes
        Badezimmer. Fundamentarbeiten, weitere Transportkilometer und der Innenausbau mit Gipskarton bzw.
        Fassadendämmung sind gegen Aufpreis erhältlich.
      </p>
    </div>

    <section id="contact" class="scroll-mt-20 not-prose my-12">
      <h2 class="font-sans font-bold text-2xl sm:text-3xl text-gray-900 mb-6 text-center">Kostenlos anfragen</h2>
      <div class="max-w-xl mx-auto">
        <MultilingualContactForm lang="de" formName="container-deutsch" />
      </div>
    </section>

    <FaqSection faqs={faqs} title="Häufige Fragen zum Containerhaus" />
  </div>
</MultilingualLayout>
