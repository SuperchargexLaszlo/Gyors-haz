---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Könnyűszerkezetes Ház 40 Nm – Legközelebbi Modelljeink';
const description =
  '40 m² körüli könnyűszerkezetes ház ára 2026-ban: a legközelebbi modelljeink a 37 m²-es Boglárka és a 47 m²-es Csillagvirág. Szobaszám, terasz, mit tartalmaz az ár.';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['konnyuszerkezetes-haz-27m2', 'konnyuszerkezetes-haz-37m2', 'konnyuszerkezetes-haz-47m2'];

const faqs = [
  {
    q: 'Van pontosan 40 m²-es modelljük?',
    a: 'A legközelebbi méreteink a 37 m²-es Boglárka (9 696 960 Ft + ÁFA) és a 47 m²-es Csillagvirág (12 317 760 Ft + ÁFA). Pontosan 40 m²-re egyedi konfigurációról ajánlatkéréskor egyeztethetünk.',
  },
  {
    q: 'Hány szoba fér el 40 m² körül?',
    a: 'A 37 m²-es Boglárkában 1 hálószoba és amerikai konyhás nappali, a 47 m²-es Csillagvirágban 2 hálószoba és amerikai konyhás nappali van.',
  },
  {
    q: 'Jó választás egy 40 m² körüli ház nyaralónak?',
    a: 'Igen, ez a mérettartomány kifejezetten népszerű nyaralóként vagy egy-két fős háztartás első otthonaként.',
  },
  {
    q: 'Elég-e egy 37 m²-es ház állandó lakhatásra?',
    a: 'Igen, a 37 m²-es Boglárka állandó lakhatásra alkalmas, 4 évszakos ház. Egy főnek vagy párnak elég. Gyermekes családnak hosszabb távon a 47 m²-es Csillagvirág javasolt.',
  },
  {
    q: 'Lehet-e bővíteni egy 37 m²-es könnyűszerkezetes házat?',
    a: 'A könnyűszerkezetes ház utólagos bővítése lehetséges, de statikai tervezést igényel. Érdemes már tervezéskor gondolni a jövőbeli bővítés lehetőségére.',
  },
  {
    q: 'Melyik modell épül gyorsabban, a 37 m²-es vagy a 47 m²-es?',
    a: 'Mindkét modell kivitelezési ideje hasonló: az alapozástól számítva 6–8 hét. A kisebb ház (37 m²) esetén a szerelési idő néhány nappal rövidebb lehet.',
  },
  {
    q: 'Milyen telekre alkalmas egy 37–47 m²-es könnyűszerkezetes ház?',
    a: 'Az OTÉK és a helyi HÉSZ előírásaitól függ. Általában 300–400 m²-es telek elegendő, de kisebb, 250 m²-es telkeken is megvalósítható, ha a beépítési arány és az előírások engedik.',
  },
];

const kapcsolodoKeresesek = [
  { label: '50 m² könnyűszerkezetes ház', href: '/50m2-konnyuszerkezetes-haz' },
  { label: 'Kis könnyűszerkezetes házak', href: '/kis-konnyuszerkezetes-hazak' },
  { label: '80 m² könnyűszerkezetes ház', href: '/80-m2-konnyuszerkezetes-haz' },
  { label: 'Könnyűszerkezetes ház árak', href: '/konnyuszerkezetes-haz-arak' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes', href: '/konnyuszerkezetes' },
  { label: 'Könnyűszerkezetes Ház 40 Nm' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="konnyuszerkezetes"
  tags={['40 nm', 'könnyűszerkezetes ház', 'árak']}
  summary="A 40 m² körüli igényhez legközelebb a 37 m²-es Boglárka (9 696 960 Ft + ÁFA) és a 47 m²-es Csillagvirág (12 317 760 Ft + ÁFA) áll. Mindkettő 4 évszakos, acélvázas kivitelben készül."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    A 40 m² körüli alapterület kompakt, praktikus megoldás egy-két fős háztartásnak vagy nyaralónak.
    Bemutatjuk a hozzá legközelebb álló modelljeinket.
  </p>

  <h2>Mennyibe kerül egy 40 m² körüli könnyűszerkezetes ház?</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Modell</th><th>Alapterület</th><th>Szobák</th><th>Ár (+ ÁFA)</th></tr>
      </thead>
      <tbody>
        <tr><td>Árnika (27 m²)</td><td>27 m²</td><td>1</td><td>7 076 160 Ft + ÁFA</td></tr>
        <tr><td>Boglárka (37 m²)</td><td>37 m²</td><td>1</td><td>9 696 960 Ft + ÁFA</td></tr>
        <tr><td>Csillagvirág (47 m²)</td><td>47 m²</td><td>2</td><td>12 317 760 Ft + ÁFA</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Ajánlott modellek</h2>

  <div class="not-prose my-6">
    <HazakGrid slugok={ajanlottSlugok} columns={3} />
  </div>

  <h2>Mit kínál a 37 m²-es Boglárka?</h2>

  <p>
    A Boglárka 37 m²-en 1 hálószobát, amerikai konyhás nappalit, fürdőszobát és 5 m²-es fedett teraszt
    ad. Alapára 9 696 960 Ft + ÁFA, kulcsrakész ára 21 134 400 Ft + ÁFA. Az alapár tartalmazza az
    acélvázat, a 10 cm vastag falakat, a 3 rétegű üvegezésű ablakokat és a belső gipszkartonozást.
    Egy főnek vagy párnak elég, nyaralónak vagy első otthonnak is használható.
  </p>

  <h2>Mit kínál a 47 m²-es Csillagvirág?</h2>

  <p>
    A Csillagvirág 47 m²-en 2 hálószobát, amerikai konyhás nappalit és fürdőszobát ad, 13 m²-es terasz
    külön kérhető hozzá. Alapára 12 317 760 Ft + ÁFA, ez 2 620 800 Ft-tal több a Boglárkáénál, 10 m²-rel
    nagyobb alapterületért. A második szoba lehet gyerekszoba, vendégszoba vagy dolgozószoba. Ha gyereket
    terveztek, ez a jobb választás.
  </p>

  <h2>37 m² és 47 m² – összehasonlítás</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Szempont</th><th>Boglárka (37 m²)</th><th>Csillagvirág (47 m²)</th></tr>
      </thead>
      <tbody>
        <tr><td>Alapár</td><td>9 696 960 Ft + ÁFA</td><td>12 317 760 Ft + ÁFA</td></tr>
        <tr><td>Kulcsrakész ár</td><td>21 134 400 Ft + ÁFA</td><td>27 109 600 Ft + ÁFA</td></tr>
        <tr><td>Ideális létszám</td><td>1–2 fő</td><td>2–3 fő</td></tr>
        <tr><td>Telek szükséglet</td><td>250–400 m²</td><td>300–500 m²</td></tr>
        <tr><td>Fűtési költség (havi, télen)</td><td>~12.000–18.000 Ft</td><td>~15.000–22.000 Ft</td></tr>
        <tr><td>Sávalap</td><td>a kulcsrakész ár tartalmazza</td><td>a kulcsrakész ár tartalmazza</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Melyiket válasszam?</h2>

  <p><strong>Válaszd a Boglárkát (37 m²), ha:</strong></p>
  <ul>
    <li>egyedülálló vagy, vagy páros lakhatásban gondolkozol</li>
    <li>a budget szűkös és a minimalizmus vonz</li>
    <li>elsősorban nyaralóként, Airbnb szállásként vagy ideiglenes otthonként tervezed</li>
    <li>a telek kisebb (250–350 m²)</li>
    <li>nem tervezel gyereket rövidtávon</li>
  </ul>

  <p><strong>Válaszd a Csillagvirágot (47 m²), ha:</strong></p>
  <ul>
    <li>párban éltek és gyermeket terveztek</li>
    <li>kell egy extra szoba (home office, vendégszoba)</li>
    <li>hosszabb távon gondolkodsz és rugalmasabb elrendezést szeretnél</li>
  </ul>

  <h2>Egyéb modellek a közelben</h2>

  <p>
    Ha egyik fenti modell sem pontos, érdemes megnézni a
    <a href="/konnyuszerkezetes/konnyuszerkezetes-haz-27m2">27 m²-es Árnikát</a> (7 076 160 Ft + ÁFA) – ez a
    legkisebb, egy hálószobás házunk –, vagy az
    <a href="/konnyuszerkezetes/konnyuszerkezetes-haz-58m2">58 m²-es Dáliát</a> (15 200 640 Ft + ÁFA), ha
    két hálószoba mellé külön konyha is kell.
  </p>

  <h2>Finanszírozás</h2>

  <p>
    Mindkét modell hitelre is megvásárolható. 30% önerővel a Boglárkánál kb. 6,8 millió Ft, a
    Csillagvirágnál kb. 8,6 millió Ft hitelre van szükség (nettó alapárral számolva). Részletes kalkulációért látogasd meg a
    <a href="/haz-reszletre">részletre vásárlás oldalunkat</a> vagy hívd bankfüggetlen tanácsadónkat.
  </p>

  <div class="not-prose">
    <FaqSection faqs={faqs} title="Gyakran ismételt kérdések" />
  </div>

  <h2>Teljes könnyűszerkezetes-kínálatunk</h2>

  <div class="not-prose my-6">
    <HazakGrid kategoria="konnyuszerkezetes" columns={3} />
  </div>

  <div class="not-prose my-10 text-center rounded-xl bg-primary/5 border border-primary/10 p-8">
    <p class="font-sans font-bold text-xl text-gray-900 mb-3">Érdekli egy 40 m² körüli ház?</p>
    <p class="text-gray-600 mb-5">
      Kötelezettség nélkül, 1 munkanapon belül visszahívjuk – vagy hívjon most: <strong>+36 70 777 8372</strong>
    </p>
    <a href="/kapcsolat" class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-dark transition-colors">
      Kérek személyre szabott ajánlatot
    </a>
  </div>

  <div class="not-prose mt-10 pt-6 border-t border-gray-100">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó keresések</p>
    <div class="flex flex-wrap gap-2">
      {kapcsolodoKeresesek.map((item) => (
        <a href={item.href} class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
