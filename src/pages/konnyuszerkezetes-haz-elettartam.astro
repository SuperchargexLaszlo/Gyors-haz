---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Könnyűszerkezetes Ház Élettartama – Mire Számíthat?';
const description =
  'Mennyi a könnyűszerkezetes ház élettartama? Mit befolyásol a tartósságot, és milyen karbantartásra van szükség hosszú távon?';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['konnyuszerkezetes-haz-52m2', 'konnyuszerkezetes-haz-78m2', 'konnyuszerkezetes-haz-96m2'];

const faqs = [
  {
    q: 'Mennyi a könnyűszerkezetes ház élettartama?',
    a: 'A horganyzott acélváz-szerkezetű házak megfelelő karbantartás mellett hosszú távú, tartós használatra tervezettek. A pontos élettartam a karbantartástól és az időjárási viszonyoktól is függ – erről ajánlatkéréskor, a műszaki dokumentáció alapján adunk tájékoztatást.',
  },
  {
    q: 'Mi befolyásolja a tartósságot?',
    a: 'A karbantartás rendszeressége, a nyílászárók és a burkolatok állapota, valamint a helyszíni időjárási viszonyok.',
  },
  {
    q: 'Van gyártói garancia?',
    a: 'Igen, az új házakra jellemzően 2–5 év gyártói garanciával számolhat.',
  },
];

const kapcsolodoKeresesek = [
  { label: 'Könnyűszerkezetes ház hátrányai', href: '/konnyuszerkezetes-haz-hatranyai' },
  { label: 'Acélvázas könnyűszerkezetes ház árak', href: '/acelvazas-konnyuszerkezetes-haz-arak' },
  { label: 'Könnyűszerkezetes ház gyártók', href: '/konnyuszerkezetes-haz-gyartok' },
  { label: 'Könnyűszerkezetes ház árak', href: '/konnyuszerkezetes-haz-arak' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes', href: '/konnyuszerkezetes' },
  { label: 'Könnyűszerkezetes Ház Élettartama' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="konnyuszerkezetes"
  tags={['élettartam', 'tartósság', 'könnyűszerkezetes']}
  summary="A horganyzott acélváz-szerkezetű könnyűszerkezetes házak megfelelő karbantartás mellett hosszú távú, tartós használatra tervezettek. A pontos élettartam a karbantartástól és a helyi időjárási viszonyoktól is függ."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    Az élettartam gyakori kérdés vásárlás előtt. Ebben a cikkben őszintén összefoglaljuk, mit lehet
    biztonsággal állítani, és mi az, ami egyedi felmérést igényel.
  </p>

  <h2>Mennyibe kerül egy könnyűszerkezetes ház?</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Modell</th><th>Alapterület</th><th>Ár (+ ÁFA)</th></tr>
      </thead>
      <tbody>
        <tr><td>52 m²-es modell</td><td>52 m²</td><td>22.000 EUR</td></tr>
        <tr><td>78 m²-es modell</td><td>78 m²</td><td>31.000 EUR</td></tr>
        <tr><td>96 m²-es modell</td><td>96 m²</td><td>35.000 EUR</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Ajánlott modellek</h2>

  <div class="not-prose my-6">
    <HazakGrid slugok={ajanlottSlugok} columns={3} />
  </div>

  <h2>Mi befolyásolja a tartósságot?</h2>

  <p>
    A horganyzott acélváz nem korhad, nem rothad, ami hosszú távú tartósságot eredményez. A pontos
    élettartamot ugyanakkor több tényező befolyásolja: a rendszeres karbantartás, a nyílászárók és
    burkolatok állapota, valamint a helyszíni időjárási viszonyok. Konkrét évekre lebontott
    élettartam-számot felelősségteljesen csak egyedi, műszaki dokumentáció alapján lehet megadni – ezt
    ajánlatkéréskor tudjuk biztosítani.
  </p>

  <h2>Kinek fontos ez a téma?</h2>

  <p>Érdemes elolvasni, ha:</p>
  <ul>
    <li>hosszú távú befektetésként tekint a vásárlásra</li>
    <li>fontos szempont a gyártói garancia</li>
  </ul>

  <div class="not-prose">
    <FaqSection faqs={faqs} title="Gyakran ismételt kérdések" />
  </div>

  <h2>Teljes könnyűszerkezetes-kínálatunk</h2>

  <div class="not-prose my-6">
    <HazakGrid kategoria="konnyuszerkezetes" columns={3} />
  </div>

  <div class="not-prose my-10 text-center rounded-xl bg-primary/5 border border-primary/10 p-8">
    <p class="font-sans font-bold text-xl text-gray-900 mb-3">Kérdése van a tartósságról?</p>
    <p class="text-gray-600 mb-5">
      Kötelezettség nélkül, 1 munkanapon belül visszahívjuk – vagy hívjon most: <strong>+36 70 777 8372</strong>
    </p>
    <a href="/kapcsolat" class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-dark transition-colors">
      Kérek szakmai tájékoztatást és ajánlatot
    </a>
  </div>

  <div class="not-prose mt-10 pt-6 border-t border-gray-100">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó keresések</p>
    <div class="flex flex-wrap gap-2">
      {kapcsolodoKeresesek.map((item) => (
        <a href={item.href} class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
