---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Könnyűszerkezetes Lapostető? – Nálunk Döntött Tető a Standard';
const description =
  'Lapostetős könnyűszerkezetes házat keres? Modelljeink 35°-os döntött tetővel készülnek, nem lapostetővel. Elmagyarázzuk, miért, és mit kínálunk.';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['konnyuszerkezetes-haz-27m2', 'konnyuszerkezetes-haz-47m2', 'konnyuszerkezetes-haz-88m2'];

const faqs = [
  {
    q: 'Van lapostetős modelljük?',
    a: 'Jelenlegi modelljeink döntött, cserepes lemez tetővel készülnek, nem lapostetővel.',
  },
  {
    q: 'Miért döntött tető és nem lapos?',
    a: 'A döntött tető jobban elvezeti a csapadékot, és kevesebb karbantartást igényel hosszú távon, mint egy lapostető.',
  },
  {
    q: 'Lehet egyedi igény szerint lapostetőt kérni?',
    a: 'Egyedi tervezésű, lapostetős kivitelről ajánlatkéréskor, egyedi felmérés alapján tudunk tájékoztatást adni.',
  },
];

const kapcsolodoKeresesek = [
  { label: 'Könnyűszerkezetes tető', href: '/konnyuszerkezetes-teto' },
  { label: 'Könnyűszerkezetes fal', href: '/konnyuszerkezetes-fal' },
  { label: 'Könnyűszerkezetes ház szigetelése', href: '/konnyuszerkezetes-haz-szigetelese' },
  { label: 'Könnyűszerkezetes ház árak', href: '/konnyuszerkezetes-haz-arak' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes', href: '/konnyuszerkezetes' },
  { label: 'Könnyűszerkezetes Lapostető' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="konnyuszerkezetes"
  tags={['lapostető', 'tetőszerkezet', 'könnyűszerkezetes']}
  summary="Fontos tisztázni: jelenlegi könnyűszerkezetes modelljeink döntött, 35°-os cserepes lemez tetővel készülnek, nem lapostetővel. A döntött tető jobban elvezeti a csapadékot és kevesebb karbantartást igényel."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    Fontos elöljáróban tisztázni: jelenlegi modelljeink döntött tetővel készülnek, nem lapostetővel.
    Elmagyarázzuk, miért, és mit kínálunk helyette.
  </p>

  <h2>Mennyibe kerül egy könnyűszerkezetes ház?</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Modell</th><th>Alapterület</th><th>Ár (+ ÁFA)</th></tr>
      </thead>
      <tbody>
        <tr><td>Árnika (27 m²)</td><td>27 m²</td><td>7 076 160 Ft + ÁFA</td></tr>
        <tr><td>Csillagvirág (47 m²)</td><td>47 m²</td><td>12 317 760 Ft + ÁFA</td></tr>
        <tr><td>Erika (69 m²)</td><td>69 m²</td><td>18 083 520 Ft + ÁFA</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Ajánlott modellek</h2>

  <div class="not-prose my-6">
    <HazakGrid slugok={ajanlottSlugok} columns={3} />
  </div>

  <h2>Miért döntött tető és nem lapos?</h2>

  <p>
    A döntött, cserepes lemez tető jobban elvezeti a csapadékot, mint egy lapostető, és hosszú távon
    kevesebb karbantartást igényel (pl. nincs szükség olyan gyakori vízszigetelés-ellenőrzésre). Ha
    kifejezetten lapostetős, modern megjelenésű megoldást keres, ez egyedi tervezést igényelne –
    erről ajánlatkéréskor tudunk tájékoztatást adni.
  </p>

  <div class="not-prose">
    <FaqSection faqs={faqs} title="Gyakran ismételt kérdések" />
  </div>

  <h2>Teljes könnyűszerkezetes-kínálatunk</h2>

  <div class="not-prose my-6">
    <HazakGrid kategoria="konnyuszerkezetes" columns={3} />
  </div>

  <div class="not-prose my-10 text-center rounded-xl bg-primary/5 border border-primary/10 p-8">
    <p class="font-sans font-bold text-xl text-gray-900 mb-3">Nézze meg a döntött tetős modelljeinket</p>
    <p class="text-gray-600 mb-5">
      Kötelezettség nélkül, 1 munkanapon belül visszahívjuk – vagy hívjon most: <strong>+36 70 777 8372</strong>
    </p>
    <a href="/kapcsolat" class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-dark transition-colors">
      Kérek személyre szabott ajánlatot
    </a>
  </div>

  <div class="not-prose mt-10 pt-6 border-t border-gray-100">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó keresések</p>
    <div class="flex flex-wrap gap-2">
      {kapcsolodoKeresesek.map((item) => (
        <a href={item.href} class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
