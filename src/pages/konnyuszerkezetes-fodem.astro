---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Könnyűszerkezetes Födém – Padlószerkezet és Szigetelés';
const description =
  'Könnyűszerkezetes ház födém- és padlószerkezete: mit tartalmaz, hogyan szigetelt, és miért fontos a hideg talaj elleni védelemben?';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['konnyuszerkezetes-haz-47m2', 'konnyuszerkezetes-haz-88m2', 'konnyuszerkezetes-haz-95m2'];

const faqs = [
  {
    q: 'Milyen szigetelést tartalmaz a padlószerkezet?',
    a: 'A padlóban is 10 cm hungarocell szigetelés van, amely gyárilag, a szállítmány részeként épül be – nem utólagos extra.',
  },
  {
    q: 'Miért fontos a padlószigetelés?',
    a: 'A hideg leginkább alulról, a talaj felől hatol be az épületbe – a jó padlószigetelés ezt akadályozza meg, és jelentősen hozzájárul a téli komforthoz.',
  },
  {
    q: 'Az alapozás vagy a födém felelős a hőszigetelésért?',
    a: 'Mindkettő szerepet játszik: a födém (padlószerkezet) gyári szigetelése és a megfelelően kivitelezett alapozás együtt biztosítja a hatékony hőszigetelést alulról.',
  },
];

const kapcsolodoKeresesek = [
  { label: 'Könnyűszerkezetes fal', href: '/konnyuszerkezetes-fal' },
  { label: 'Könnyűszerkezetes ház alapozása', href: '/konnyuszerkezetes-haz-alapozasa' },
  { label: 'Könnyűszerkezetes ház szigetelése', href: '/konnyuszerkezetes-haz-szigetelese' },
  { label: 'Könnyűszerkezetes ház árak', href: '/konnyuszerkezetes-haz-arak' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes', href: '/konnyuszerkezetes' },
  { label: 'Könnyűszerkezetes Födém' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="konnyuszerkezetes"
  tags={['födém', 'padlószerkezet', 'könnyűszerkezetes']}
  summary="A könnyűszerkezetes ház padlószerkezete gyárilag 10 cm hungarocell szigeteléssel készül – ez a szállítmány része, nem utólagos extra. A padló felőli hőszigetelés kulcsfontosságú a téli komfort szempontjából."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    A padlószerkezet (födém) gyakran kevesebb figyelmet kap, mint a falak vagy a tető, pedig a téli
    komfort szempontjából kulcsfontosságú – a hideg ugyanis leginkább alulról hatol be az épületbe.
  </p>

  <h2>Mennyibe kerül egy könnyűszerkezetes ház?</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Modell</th><th>Alapterület</th><th>Ár (+ ÁFA)</th></tr>
      </thead>
      <tbody>
        <tr><td>Csillagvirág (47 m²)</td><td>47 m²</td><td>12 317 760 Ft + ÁFA</td></tr>
        <tr><td>Erika (69 m²)</td><td>69 m²</td><td>18 083 520 Ft + ÁFA</td></tr>
        <tr><td>Hanga (95 m²)</td><td>95 m²</td><td>24 897 600 Ft + ÁFA</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Ajánlott modellek</h2>

  <div class="not-prose my-6">
    <HazakGrid slugok={ajanlottSlugok} columns={3} />
  </div>

  <h2>A padlószerkezet felépítése</h2>

  <p>
    Minden modellünk padlószerkezete gyárilag 10 cm hungarocell szigeteléssel készül. Ez a szállítmány
    része, nem utólag beépítendő extra. A megfelelő padlószigetelés kiegészülve a helyszíni alapozással
    (amely szintén szigetelt kivitelben javasolt) biztosítja, hogy a ház alulról ne hűljön ki télen.
  </p>

  <h2>Kinek fontos ez a téma?</h2>

  <p>Érdemes elolvasni, ha:</p>
  <ul>
    <li>egész éves, téli használatra tervezi a házat</li>
    <li>szeretné megérteni, mi tartozik a gyári szállítmányba</li>
  </ul>

  <div class="not-prose">
    <FaqSection faqs={faqs} title="Gyakran ismételt kérdések" />
  </div>

  <h2>Teljes könnyűszerkezetes-kínálatunk</h2>

  <div class="not-prose my-6">
    <HazakGrid kategoria="konnyuszerkezetes" columns={3} />
  </div>

  <div class="not-prose my-10 text-center rounded-xl bg-primary/5 border border-primary/10 p-8">
    <p class="font-sans font-bold text-xl text-gray-900 mb-3">Kérdése van a szigetelésről?</p>
    <p class="text-gray-600 mb-5">
      Kötelezettség nélkül, 1 munkanapon belül visszahívjuk – vagy hívjon most: <strong>+36 70 777 8372</strong>
    </p>
    <a href="/kapcsolat" class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-dark transition-colors">
      Kérek szakmai tájékoztatást és ajánlatot
    </a>
  </div>

  <div class="not-prose mt-10 pt-6 border-t border-gray-100">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó keresések</p>
    <div class="flex flex-wrap gap-2">
      {kapcsolodoKeresesek.map((item) => (
        <a href={item.href} class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
