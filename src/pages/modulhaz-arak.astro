---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Modulház Árak 2026 – Ticab Modellek 22.200 EUR-tól';
const description =
  'Modulház árak 2026-ban: Ticab modellek 15,2 m²-től 144 m²-ig, 22.200 EUR-tól 150.000 EUR-ig + ÁFA. Modellenkénti ártáblázat, változatok, mit tartalmaz az ár.';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['modulhaz-amsterdam', 'modulhaz-stockholm', 'modulhaz-barcelona'];

const faqs = [
  {
    q: 'Mennyibe kerül egy modulház?',
    a: 'A Ticab modulházak listaára 22.200 EUR-tól (Seville, 22 m²) 150.000 EUR-ig (London, 144 m², Happy Wife, 122 m²) terjed, + ÁFA. Egy 50 m² körüli modell 50.000–54.000 EUR + ÁFA.',
  },
  {
    q: 'Mit nem tartalmaz a listaár?',
    a: 'A szállítást, az alapozást, a külső közműbekötéseket és a darus lerakodást. A legtöbb lakómodellnél a konyhabútor, a mosdószekrény és a padlófűtés is külön tétel.',
  },
  {
    q: 'Mennyi idő alatt készül el egy modulház?',
    a: 'A gyártás, szállítás és helyszíni összeszerelés jellemzően 8–16 hetet vesz igénybe.',
  },
  {
    q: 'Bővíthető egy modulház?',
    a: 'Igen, a moduláris szerkezet lehetővé teszi a bővítést egy újabb modul hozzáadásával. Ez ideális megoldás azoknak, akik fokozatosan szeretnék növelni a ház méretét.',
  },
  {
    q: 'Kell-e alapozás a Ticab modulházhoz?',
    a: 'Igen, minden modulházhoz szükséges valamilyen alap. Könnyű modulok esetén elegendő lehet a talpgerendás vagy pontalapos megoldás, míg nagyobb, nehezebb épületeknél lemezalap javasolt. Az alapozás munkadíja kb. 1.400.000 Ft + ÁFA, de a pontos összeg a típustól és a helyszíntől is függ.',
  },
];

const kapcsolodoKeresesek = [
  { label: 'Luxus mobilház', href: '/luxus-mobilhaz' },
  { label: 'Modern mobilház árak', href: '/modern-mobilhaz-arak' },
  { label: 'Modulház és álomterasz', href: '/modulhaz-es-alomterasz' },
  { label: 'Mobilház árak', href: '/mobilhaz-arak' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Modulházak', href: '/modulhaz' },
  { label: 'Modulház Árak' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="modulhaz"
  tags={['modulház', 'árak', 'Ticab']}
  summary="A Ticab modulházak listaára 22.200 EUR-tól 150.000 EUR-ig terjed, + ÁFA. A modellsor 15,2 m²-től 144 m²-ig tart, emellett van szauna-, iroda- és kávézómodul is."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    A Ticab modulházak gyárilag előre gyártott otthonok, fix listaárral. Ebben a cikkben modellenként
    megadjuk az árat, és leírjuk, mi van benne az árban.
  </p>

  <h2>Mi az a modulház?</h2>

  <p>
    A modulház egy gyárilag, modul egységenként előre gyártott épület, amelyet a helyszínen
    összeszerelnek. Minden egység a gyárban kerül befejezésre: burkolatok, elektromos és vízvezeték
    szerelés, nyílászárók – minden a gyárból érkezik, a helyszínen csak az összekötés és a
    csatlakoztatás történik.
  </p>

  <p>A modulházak előnye a hagyományos kivitelezéssel szemben:</p>
  <ul>
    <li>Rövidebb kivitelezési idő (8–16 hét)</li>
    <li>Kiszámítható költségek, nincs "meglepetés"</li>
    <li>Gyári minőségellenőrzés</li>
    <li>Moduláris bővíthetőség</li>
  </ul>

  <h2>Modulház árak méretkategóriánként</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Kategória</th><th>Mérettartomány</th><th>Ár (+ ÁFA)</th></tr>
      </thead>
      <tbody>
        <tr><td>Tiny House</td><td>15,2–18 m²</td><td>30.000–38.000 EUR</td></tr>
        <tr><td>Kis modellek</td><td>20–47,5 m²</td><td>22.200–48.400 EUR</td></tr>
        <tr><td>Közepes modellek</td><td>48–72 m²</td><td>45.000–75.350 EUR</td></tr>
        <tr><td>Nagy modellek</td><td>88–144 m²</td><td>67.000–150.000 EUR</td></tr>
        <tr><td>Szauna, iroda, kávézó</td><td>5,6–35 m²</td><td>14.300–47.800 EUR</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Ticab modellek és árak</h2>

  <p>
    Az árak a <a href="https://www.ticabhouse.com/" target="_blank" rel="noopener">Ticab House</a> modelljeire
    vonatkoznak, euróban, ÁFA nélkül. Az ár nem tartalmazza a szállítást, az alapozást, a külső
