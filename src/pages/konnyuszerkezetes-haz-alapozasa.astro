---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Könnyűszerkezetes Ház Alapozása – Típusok és Árak 2026';
const description =
  'Könnyűszerkezetes ház alapozása: pontalapos vagy lemezalap? Mibe kerül, mikor melyiket érdemes választani? Gyakorlati útmutató telepítés előtt.';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['konnyuszerkezetes-haz-35m2', 'konnyuszerkezetes-haz-62m2', 'konnyuszerkezetes-haz-87m2'];

const faqs = [
  {
    q: 'Mennyibe kerül a könnyűszerkezetes ház alapozása?',
    a: 'Az alapozás munkadíja jellemzően kb. 1.400.000 Ft + ÁFA körül alakul. A pontos összeg a telek adottságaitól, a talaj típusától és a választott alapozási módtól függ – helyszíni felmérés után tudunk pontos árat adni.',
  },
  {
    q: 'Pontalapos vagy lemezalap a jobb választás?',
    a: 'Ez a talaj teherbírásától és a telek adottságaitól függ. Mindkét megoldásnak megvannak a maga előnyei – a pontos ajánlást helyszíni felmérés alapján, a talajviszonyok ismeretében tudjuk megadni.',
  },
  {
    q: 'Az alapozás ára benne van a ház árában?',
    a: 'Nem, az alapozás minden modellünknél külön tétel, mivel a szükséges alapozás típusa és költsége telkenként eltérő.',
  },
  {
    q: 'Ki végzi az alapozást?',
    a: 'Az alapozást helyi kivitelezővel koordináljuk az igény szerint. A pontos folyamatról ajánlatkéréskor adunk tájékoztatást.',
  },
];

const kapcsolodoKeresesek = [
  { label: '4 évszakos mobilház árak', href: '/4-evszakos-mobilhaz-arak' },
  { label: 'Acélvázas könnyűszerkezetes ház árak', href: '/acelvazas-konnyuszerkezetes-haz-arak' },
  { label: 'Konténerház alapozás', href: '/kontenerhaz-alapozas' },
  { label: 'Könnyűszerkezetes ház árak', href: '/konnyuszerkezetes-haz-arak' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes', href: '/konnyuszerkezetes' },
  { label: 'Könnyűszerkezetes Ház Alapozása' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="konnyuszerkezetes"
  tags={['könnyűszerkezetes', 'alapozás', 'pontalapos', 'lemezalap']}
  summary="A könnyűszerkezetes ház alapozásának munkadíja jellemzően kb. 1.400.000 Ft + ÁFA – ez minden modellnél külön tétel, nincs benne az alapárban. A pontos típust (pontalapos vagy lemezalap) a telek talajviszonyai határozzák meg."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    A könnyűszerkezetes ház gyári szerkezete önmagában nem elég – a tartós, biztonságos telepítéshez
    megfelelő alapozásra is szükség van. Ebben a cikkben bemutatjuk, milyen alapozási típusok léteznek,
    és mibe kerülnek.
  </p>

  <h2>Mennyibe kerül a könnyűszerkezetes ház alapozása?</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr>
          <th>Tétel</th>
          <th>Jellemző összeg</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Alapozás munkadíja</td>
          <td>kb. 1.400.000 Ft + ÁFA</td>
        </tr>
        <tr>
          <td>Könnyűszerkezetes ház alapára (22–126 m²)</td>
          <td>16.000–43.000 EUR + ÁFA</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Az alapozás minden modellünknél külön tétel – az alapár ezt nem tartalmazza, mert a szükséges alapozás
    típusa és pontos költsége a telek adottságaitól függ.
  </p>

  <h2>Ajánlott modellek</h2>

  <div class="not-prose my-6">
    <HazakGrid slugok={ajanlottSlugok} columns={3} />
  </div>

  <h2>Milyen alapozás típusok léteznek?</h2>

  <p>
    A leggyakoribb megoldások a <strong>pontalapos</strong> és a <strong>lemezalap</strong> kivitelek.
    A pontalapos megoldásnál az épület terhét pontszerű alapokra vezetik le, ez jellemzően jobb
    teherbírású, stabil talajon alkalmazható. A lemezalap egy teljes felületű betonlemez, amely
    egyenletesebben osztja el a terhelést – ez gyakran a jobb választás kevésbé teherbíró vagy
    egyenetlenebb talajviszonyok esetén.
  </p>

  <p>
    A pontos típust mindig a telek talajviszonyai, a helyi adottságok és a választott ház mérete alapján
    érdemes eldönteni – erre helyszíni felmérés után tudunk konkrét javaslatot tenni.
  </p>

  <h2>Kinek melyik alapozás típus ajánlott?</h2>

  <p>Pontalapos megoldás jó választás lehet, ha:</p>
  <ul>
    <li>a talaj jó teherbírású és stabil</li>
    <li>a költséghatékonyság elsődleges szempont</li>
  </ul>

  <p>Lemezalap ajánlott lehet, ha:</p>
  <ul>
    <li>a talaj egyenetlenebb vagy kevésbé teherbíró</li>
    <li>fontos szempont az egyenletes teherelosztás és a hosszú távú stabilitás</li>
  </ul>

  <div class="not-prose">
    <FaqSection faqs={faqs} title="Gyakran ismételt kérdések az alapozásról" />
  </div>

  <h2>Teljes könnyűszerkezetes-kínálatunk</h2>

  <div class="not-prose my-6">
    <HazakGrid kategoria="konnyuszerkezetes" columns={3} />
  </div>

  <div class="not-prose my-10 text-center rounded-xl bg-primary/5 border border-primary/10 p-8">
    <p class="font-sans font-bold text-xl text-gray-900 mb-3">
      Segítünk az alapozás megtervezésében is
    </p>
    <p class="text-gray-600 mb-5">
      Kötelezettség nélkül, 1 munkanapon belül visszahívjuk – vagy hívjon most: <strong>+36 70 777 8372</strong>
    </p>
    <a
      href="/kapcsolat"
      class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-dark transition-colors"
    >
      Kérek helyszíni felmérést és ajánlatot
    </a>
  </div>

  <div class="not-prose mt-10 pt-6 border-t border-gray-100">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó keresések</p>
    <div class="flex flex-wrap gap-2">
      {kapcsolodoKeresesek.map((item) => (
        <a
          href={item.href}
          class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
