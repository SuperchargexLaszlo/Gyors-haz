---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Konténerház Méretek – Teljes Áttekintés 2026';
const description =
  'Konténerház méretek 2026-ban: 55 m²-től 90 m²-ig. Melyik modell mekkora, hány szobás, és mekkora a terasza? Teljes összehasonlítás.';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['kontenerhaz-manhattan', 'kontenerhaz-beverly-l', 'kontenerhaz-nordic-premium'];

const faqs = [
  {
    q: 'Mekkora a legkisebb konténerház?',
    a: 'A Manhattan és a Beverly modell 55 m² alapterületű, ez a legkisebb kínálatunkban.',
  },
  {
    q: 'Mekkora a legnagyobb konténerház?',
    a: 'A Beverly L modell 90 m² alapterületű, ez a legnagyobb kínálatunkban.',
  },
  {
    q: 'Melyik modellnek van terasza?',
    a: 'Minden modellnél 2 m²-es fedett terasz jár, a Nordic Premiumnál pedig 9 m²-es.',
  },
];

const kapcsolodoKeresesek = [
  { label: 'Teljes bekerülési költség', href: '/teliesitett-kontenerhaz-arak' },
  { label: '70 nm konténerház', href: '/70-nm-kontenerhaz' },
  { label: '100 nm konténerház árak', href: '/100-nm-kontenerhaz-arak' },
  { label: 'Konténerház belülről', href: '/kontenerhaz-belulrol' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Konténerházak', href: '/kontenerhaz' },
  { label: 'Konténerház Méretek' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="kontenerhoz"
  tags={['méretek', 'konténerház', 'árak']}
  summary="A konténerház modellsorunk 55 m²-től (Manhattan, Beverly) 90 m²-ig (Beverly L) terjed, 2-3 szobával. A Nordic Premium 68 m² + 9 m²-es terasszal a legjobb kompromisszum méret és felszereltség között."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    Melyik konténerház mekkora? Ebben a cikkben egy helyen összefoglaljuk az összes modellünk méretét,
    szobaszámát és teraszát.
  </p>

  <h2>Konténerház méretek – teljes táblázat</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Modell</th><th>Alapterület</th><th>Szobák</th><th>Terasz</th><th>Ár (+ ÁFA)</th></tr>
      </thead>
      <tbody>
        <tr><td>Manhattan</td><td>55 m²</td><td>2</td><td>2 m²</td><td>12.790.000 Ft</td></tr>
        <tr><td>Manhattan L</td><td>69,3 m²</td><td>2</td><td>2 m²</td><td>13.790.000 Ft</td></tr>
        <tr><td>Beverly</td><td>55 m²</td><td>3</td><td>2 m²</td><td>15.090.000 Ft</td></tr>
        <tr><td>Beverly L</td><td>90 m²</td><td>3</td><td>2 m²</td><td>16.090.000 Ft</td></tr>
        <tr><td>Nordic Premium</td><td>68 m²</td><td>3</td><td>9 m²</td><td>25.500.000 Ft</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Ajánlott modellek méretkategóriánként</h2>

  <div class="not-prose my-6">
    <HazakGrid slugok={ajanlottSlugok} columns={3} />
  </div>

  <h2>Melyik méret kinek való?</h2>

  <p>
    Az 55 m²-es Manhattan és Beverly modellek 2-3 fős háztartásnak ideálisak. A 69-90 m² közötti
    Manhattan L és Beverly L modellek nagyobb családoknak vagy több szobát igénylőknek jó választás.
    A Nordic Premium a legjobb kompromisszum a méret, a felszereltség és a terasz mérete között.
  </p>

  <div class="not-prose">
    <FaqSection faqs={faqs} title="Gyakran ismételt kérdések" />
  </div>

  <h2>Teljes konténerház-kínálatunk</h2>

  <div class="not-prose my-6">
    <HazakGrid kategoria="kontenerhaz" columns={3} />
  </div>

  <div class="not-prose my-10 text-center rounded-xl bg-primary/5 border border-primary/10 p-8">
    <p class="font-sans font-bold text-xl text-gray-900 mb-3">Válassza ki a megfelelő méretet</p>
    <p class="text-gray-600 mb-5">
      Kötelezettség nélkül, 1 munkanapon belül visszahívjuk – vagy hívjon most: <strong>+36 70 777 8372</strong>
    </p>
    <a href="/kapcsolat" class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-dark transition-colors">
      Kérek személyre szabott ajánlatot
    </a>
  </div>

  <div class="not-prose mt-10 pt-6 border-t border-gray-100">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó keresések</p>
    <div class="flex flex-wrap gap-2">
      {kapcsolodoKeresesek.map((item) => (
        <a href={item.href} class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
