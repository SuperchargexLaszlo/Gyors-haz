---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const title = 'Ajánlatot Kérek – Kapcsolat | gyors-haz.hu';
const description =
  'Kérjen ingyenes árajánlatot könnyűszerkezetes vagy modulházhoz! Tel: +36 70 777 8372, Email: info@instantotthonok.com. Visszahívunk 24 órán belül.';

const termekParam = Astro.url.searchParams.get('termek') ?? '';
const erdeklodesParam = Astro.url.searchParams.get('erdeklodes') ?? '';

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Kapcsolat' },
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  description,
  url: 'https://gyors-haz.hu/kapcsolat',
  mainEntity: {
    '@type': 'Organization',
    name: 'Gyors Ház',
    telephone: '+36 70 777 8372',
    email: 'info@instantotthonok.com',
    url: 'https://gyors-haz.hu',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+36 70 777 8372',
      contactType: 'sales',
      availableLanguage: 'Hungarian',
    },
  },
};
---

<BaseLayout title={title} description={description} schema={contactSchema}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <Breadcrumb items={breadcrumbItems} />

    <h1 class="font-sans font-extrabold text-3xl sm:text-4xl text-gray-900 mb-3">
      Kérjen ajánlatot
    </h1>
    <p class="text-lg text-gray-600 mb-10 max-w-2xl">
      Töltse ki az alábbi űrlapot — visszahívjuk <strong>24 órán belül</strong>, kötelezettség nélkül.
    </p>

    <div class="lg:grid lg:grid-cols-3 lg:gap-12">
      <!-- Bal: kapcsolati infó -->
      <aside class="mb-10 lg:mb-0 space-y-6">
        <!-- Elérhetőségek -->
        <div class="rounded-xl bg-primary/5 p-6">
          <h2 class="font-sans font-bold text-lg text-gray-900 mb-4">Elérhetőségeink</h2>
          <ul class="space-y-3 text-sm">
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <div>
                <p class="font-medium text-gray-700">Telefon</p>
                <a href="tel:+36707778372" class="text-primary font-semibold hover:underline">+36 70 777 8372</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <div>
                <p class="font-medium text-gray-700">E-mail</p>
                <a href="mailto:info@instantotthonok.com" class="text-primary font-semibold hover:underline break-all">info@instantotthonok.com</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 shrink-0 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <p class="font-medium text-gray-700">Visszahívás</p>
                <p class="text-gray-600">H–P: 8:00–18:00</p>
                <p class="text-gray-600">Szo: 9:00–14:00</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Miért minket? -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="font-sans font-bold text-base text-gray-900 mb-3">Miért minket válasszon?</h2>
          <ul class="space-y-2 text-sm text-gray-600">
            {[
              'Gyári minőség, gyors átadás',
              '280 cm belmagasság minden típusnál',
              '3 rétegű üveg ablakok alapárban',
              'Bankfüggetlen hitelezési tanácsadó',
              'Helyszíni felmérés az egész országban',
              'Egyszerűsített bejelentési segítség',
            ].map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold shrink-0 mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Térkép placeholder -->
        <div class="rounded-xl bg-gray-100 h-48 flex items-center justify-center text-gray-400 text-sm border border-gray-200">
          <div class="text-center">
            <svg class="h-8 w-8 mx-auto mb-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p>Bemutatóterem</p>
            <p class="text-xs mt-1">Helyszín megjelenítés hamarosan</p>
          </div>
        </div>
      </aside>

      <!-- Jobb: form -->
      <div class="lg:col-span-2">
        <form
          name="ajanlatkereso"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/koszonet"
          class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm space-y-5"
        >
          <!-- Honeypot -->
          <p class="hidden">
            <label>Ne töltsd ki: <input name="bot-field" /></label>
          </p>
          <input type="hidden" name="form-name" value="ajanlatkereso" />
          {termekParam && <input type="hidden" name="termek" value={termekParam} />}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Teljes név -->
            <div>
              <label for="nev" class="block text-sm font-medium text-gray-700 mb-1">
                Teljes neve <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="nev"
                name="nev"
                required
                autocomplete="name"
                placeholder="Kovács János"
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
              />
            </div>

            <!-- Telefon -->
            <div>
              <label for="telefon" class="block text-sm font-medium text-gray-700 mb-1">
                Telefonszám <span class="text-red-500">*</span>
              </label>
              <input
                type="tel"
                id="telefon"
                name="telefon"
                required
                autocomplete="tel"
                placeholder="+36 30 123 4567"
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
              />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
              E-mail cím <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="pelda@email.hu"
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Háztípus -->
            <div>
              <label for="haztipus" class="block text-sm font-medium text-gray-700 mb-1">
                Érdeklő háztípus
              </label>
              <select
                id="haztipus"
                name="haztipus"
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors bg-white"
              >
                <option value="">Válasszon…</option>
                <option value="konnyuszerkezetes" selected={erdeklodesParam === 'konnyuszerkezetes' || termekParam.startsWith('konnyuszerkezetes')}>Könnyűszerkezetes ház</option>
                <option value="modulhaz" selected={erdeklodesParam === 'modulhaz' || termekParam.startsWith('modulhaz')}>Modulház</option>
                <option value="kontenerhoz" selected={erdeklodesParam === 'kontenerhoz'}>Konténerház</option>
                <option value="reszletre-hitelre" selected={erdeklodesParam === 'hitel'}>Részletre / hitelre</option>
              </select>
            </div>

            <!-- Méret -->
            <div>
              <label for="meret" class="block text-sm font-medium text-gray-700 mb-1">
                Tervezett méret (m²)
              </label>
              <input
                type="number"
                id="meret"
                name="meret"
                min="20"
                max="300"
                placeholder="pl. 52"
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
              />
            </div>
          </div>

          <!-- Üzenet -->
          <div>
            <label for="uzenet" class="block text-sm font-medium text-gray-700 mb-1">
              Üzenet (opcionális)
            </label>
            <textarea
              id="uzenet"
              name="uzenet"
              rows="4"
              placeholder="Pl. telekvásárlás alatt állunk, 2025 őszre tervezzük az építést…"
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors resize-y"
            ></textarea>
          </div>

          <!-- Submit -->
          <div>
            <button
              type="submit"
              class="w-full rounded-xl bg-accent py-3.5 font-sans font-bold text-white text-base hover:bg-accent-dark transition-colors shadow"
            >
              Ajánlatot kérek →
            </button>
            <p class="mt-3 text-xs text-center text-gray-400">
              Adatait biztonságosan kezeljük.
              <a href="/adatvedelmi-tajekoztato" class="underline hover:text-primary">Adatvédelmi tájékoztató</a>
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
