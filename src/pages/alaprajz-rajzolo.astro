---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Planner from '../components/Planner.astro';
import House3DViewer from '../components/House3DViewer.astro';

/**
 * Az alaprajz tervező eszköz oldala.
 *
 * Szándékosan `noindex`, és a sitemapból is kimarad (lásd astro.config.mjs):
 * a gyors-haz.hu házakat árul, a tervező ehhez egy segédeszköz. Ide a
 * termékoldalak alatti bekezdésekből lehet eljutni.
 */
const title = 'Alaprajz tervező — gyors-haz.hu';
const description =
  'Rajzold meg a házad beosztását, és kérj rá árajánlatot. A gyors-haz.hu ügyfeleinek szánt eszköz.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: 'Főoldal', href: '/' }, { label: 'Alaprajz tervező' }]} />

    <section class="py-8 lg:py-12">
      <h1 class="font-sans font-extrabold text-3xl sm:text-4xl text-gray-900 leading-tight">
        Tervezd meg a házad beosztását
      </h1>
      <p class="mt-4 max-w-2xl text-gray-600 leading-relaxed">
        Rakd össze, hogyan képzeled: helyiségek, ajtók, ablakok, bútorok és terasz,
        méterre pontosan. Nem kell letölteni és megtanulni semmit — az elemek maguktól
        a helyükre ugranak. A kész alaprajzot e-mailben elküldjük, és ha kéred,
        kollégánk 24 órán belül árajánlatot ad rá.
      </p>
    </section>

    <Planner compact={false} />

    <div class="mt-8">
      <h2 class="text-2xl font-bold text-primary mb-2">
        3D előnézet
      </h2>
      <p class="text-sm text-neutral-500 mb-4">
        Az alaprajz alapján automatikusan frissül. Forgasd az egérrel!
      </p>
      <House3DViewer width={9} depth={7} label="Saját tervem" />
    </div>

    <section class="py-12 lg:py-16">
      <h2 class="font-sans font-bold text-2xl sm:text-3xl text-gray-900 text-center">
        Mi történik ezután?
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center">
          <div class="mx-auto grid h-10 w-10 place-items-center rounded-full bg-accent/10 font-bold text-accent">1</div>
          <p class="mt-3 font-sans font-bold text-gray-900">Megrajzolod</p>
          <p class="mt-1 text-sm text-gray-500 leading-relaxed">
            Kezdj egy sablonnal vagy üres helyiséggel, majd írd be a méreteket.
            A teraszt is beteheted — külön számoljuk, mert nem fűtött tér.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center">
          <div class="mx-auto grid h-10 w-10 place-items-center rounded-full bg-accent/10 font-bold text-accent">2</div>
          <p class="mt-3 font-sans font-bold text-gray-900">Megkapod e-mailben</p>
          <p class="mt-1 text-sm text-gray-500 leading-relaxed">
            Az alaprajz PNG-ként érkezik, nyomtatható. Le is töltheted azonnal.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center">
          <div class="mx-auto grid h-10 w-10 place-items-center rounded-full bg-accent/10 font-bold text-accent">3</div>
          <p class="mt-3 font-sans font-bold text-gray-900">Árajánlatot adunk rá</p>
          <p class="mt-1 text-sm text-gray-500 leading-relaxed">
            Ha bejelölöd, 24 órán belül keresünk azzal, hogy mennyibe kerül megépítve.
          </p>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-4 text-sm">
        <a href="/konnyuszerkezetes" class="text-primary font-semibold hover:underline">Könnyűszerkezetes házak →</a>
        <a href="/modulhaz" class="text-primary font-semibold hover:underline">Modulházak →</a>
        <a href="/kontenerhaz" class="text-primary font-semibold hover:underline">Konténerházak →</a>
      </div>
    </section>
  </div>
</BaseLayout>
