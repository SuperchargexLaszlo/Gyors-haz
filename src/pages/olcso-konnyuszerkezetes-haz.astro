---
import BlogLayout from '../layouts/BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HazakGrid from '../components/HazakGrid.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Olcsó Könnyűszerkezetes Ház – Legkedvezőbb Áraink 2026';
const description =
  'Olcsó könnyűszerkezetes ház 2026-ban: legkedvezőbb áraink 16.000 EUR-tól. Mit tartalmaz az alapár, és mire figyeljen, ha a költséget minimalizálná?';
const pubDate = new Date('2026-08-01');

const ajanlottSlugok = ['konnyuszerkezetes-haz-22m2', 'konnyuszerkezetes-haz-32m2', 'konnyuszerkezetes-haz-35m2'];

const faqs = [
  {
    q: 'Melyik a legolcsóbb könnyűszerkezetes házuk?',
    a: 'A 22 m²-es modellünk a legkedvezőbb árú, 16.000 EUR + ÁFA áron.',
  },
  {
    q: 'Kompromisszum a minőségben az olcsóbb modelleknél?',
    a: 'Nem, minden modellünk ugyanazzal a szerkezeti rendszerrel (horganyzott acélváz, gyári szigetelés) készül – a méret, nem a minőség a különbség.',
  },
  {
    q: 'Hogyan lehet még csökkenteni a teljes költséget?',
    a: 'A belső befejező munkák (festés, burkolás) egy részét házilag is elvégezheti, ezzel csökkentve a teljes bekerülési költséget.',
  },
];

const kapcsolodoKeresesek = [
  { label: 'Kis könnyűszerkezetes házak', href: '/kis-konnyuszerkezetes-hazak' },
  { label: '50 m² könnyűszerkezetes ház', href: '/50m2-konnyuszerkezetes-haz' },
  { label: 'Könnyűszerkezetes ház hitel', href: '/konnyuszerkezetes-haz-hitel' },
  { label: 'Könnyűszerkezetes ház árak', href: '/konnyuszerkezetes-haz-arak' },
];

const breadcrumbItems = [
  { label: 'Főoldal', href: '/' },
  { label: 'Könnyűszerkezetes', href: '/konnyuszerkezetes' },
  { label: 'Olcsó Könnyűszerkezetes Ház' },
];
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  category="konnyuszerkezetes"
  tags={['olcsó', 'árak', 'könnyűszerkezetes']}
  summary="A legkedvezőbb árú modellünk 16.000 EUR + ÁFA (22 m²) – minden modellünk ugyanazzal a szerkezeti rendszerrel készül, a méret, nem a minőség a különbség a belépő és a nagyobb modellek között."
>
  <Breadcrumb items={breadcrumbItems} />

  <p>
    Ha a költségvetés az elsődleges szempont, érdemes tudni, hogy a legkisebb modelljeink ugyanazzal a
    szerkezeti minőséggel készülnek, mint a nagyobbak – csak kisebb alapterületen.
  </p>

  <h2>Legkedvezőbb áraink</h2>

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th>Modell</th><th>Alapterület</th><th>Ár (+ ÁFA)</th></tr>
      </thead>
      <tbody>
        <tr><td>22 m²-es modell</td><td>22 m²</td><td>16.000 EUR</td></tr>
        <tr><td>32 m²-es modell</td><td>32 m²</td><td>18.600 EUR</td></tr>
        <tr><td>35 m²-es modell</td><td>35 m²</td><td>20.300 EUR</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Ajánlott modellek</h2>

  <div class="not-prose my-6">
    <HazakGrid slugok={ajanlottSlugok} columns={3} />
  </div>

  <h2>Mire figyeljen a költségek minimalizálásánál?</h2>

  <p>
    A ház alapára mellett érdemes az alapozás (kb. 1.400.000 Ft + ÁFA) és a szállítás költségével is
    számolni. A belső befejező munkák (festés, burkolás) egy részét házilag is elvégezheti, ezzel tovább
    csökkentve a teljes bekerülési költséget – hasonlóan ahhoz, ahogy ezt a konténerházaknál is
    összefoglaltuk.
  </p>

  <div class="not-prose">
    <FaqSection faqs={faqs} title="Gyakran ismételt kérdések" />
  </div>

  <h2>Teljes könnyűszerkezetes-kínálatunk</h2>

  <div class="not-prose my-6">
    <HazakGrid kategoria="konnyuszerkezetes" columns={3} />
  </div>

  <div class="not-prose my-10 text-center rounded-xl bg-primary/5 border border-primary/10 p-8">
    <p class="font-sans font-bold text-xl text-gray-900 mb-3">Érdekli a legkedvezőbb árú modellünk?</p>
    <p class="text-gray-600 mb-5">
      Kötelezettség nélkül, 1 munkanapon belül visszahívjuk – vagy hívjon most: <strong>+36 70 777 8372</strong>
    </p>
    <a href="/kapcsolat" class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-dark transition-colors">
      Kérek személyre szabott ajánlatot
    </a>
  </div>

  <div class="not-prose mt-10 pt-6 border-t border-gray-100">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Kapcsolódó keresések</p>
    <div class="flex flex-wrap gap-2">
      {kapcsolodoKeresesek.map((item) => (
        <a href={item.href} class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
