---
interface Props {
  images: string[];
  productName: string;
}

const { images, productName } = Astro.props;

const safeImages = images && images.length > 0 ? images : ['/images/placeholder.webp'];
const mainImage = safeImages[0];
const thumbImages = safeImages.slice(1, 5);
const totalCount = safeImages.length;
const remainingCount = totalCount > 5 ? totalCount - 5 : 0;
---

<div class="product-gallery">
  <!-- Főkép -->
  <button
    type="button"
    class="group relative block w-full aspect-[4/3] overflow-hidden rounded-2xl bg-gray-100"
    data-gallery-open
    data-index="0"
    aria-label={`${productName} – kép megnyitása nagyban`}
  >
    <img
      src={mainImage}
      alt={`${productName} – fókép`}
      loading="eager"
      decoding="async"
      width="1200"
      height="900"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span class="absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full bg-black/70 px-3 py-1.5 text-xs font-semibold text-white shadow">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
        <circle cx="12" cy="13" r="3.5" stroke-width="2" />
      </svg>
      {totalCount} fotó
    </span>
  </button>

  <!-- Thumbnail rács -->
  {thumbImages.length > 0 && (
    <div class="mt-3 grid grid-cols-4 gap-2">
      {thumbImages.map((img, i) => {
        const index = i + 1;
        const showOverlay = remainingCount > 0 && i === thumbImages.length - 1;
        return (
          <button
            type="button"
            class="group relative aspect-square overflow-hidden rounded-lg bg-gray-100"
            data-gallery-open
            data-index={index}
            aria-label={`${productName} – ${index + 1}. kép megnyitása nagyban`}
          >
            <img
              src={img}
              alt={`${productName} – kép ${index + 1}`}
              loading="lazy"
              decoding="async"
              width="300"
              height="300"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            {showOverlay && (
              <span class="absolute inset-0 flex items-center justify-center bg-black/60 text-lg font-bold text-white">
                +{remainingCount}
              </span>
            )}
          </button>
        );
      })}
    </div>
  )}

  <!-- Lightbox -->
  <div
    id="pg-lightbox"
    class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/95 p-4"
    role="dialog"
    aria-modal="true"
    aria-label={`${productName} – galéria`}
  >
    <button
      type="button"
      id="pg-lightbox-close"
      class="absolute top-4 right-4 z-10 rounded-full bg-white/10 p-2 text-white/90 transition-colors hover:bg-white/20 hover:text-white"
      aria-label="Bezárás"
    >
      <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <span id="pg-lightbox-counter" class="absolute top-5 left-4 z-10 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold text-white"></span>

    <button
      type="button"
      id="pg-lightbox-prev"
      class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/10 p-2 text-white/90 transition-colors hover:bg-white/20 hover:text-white sm:left-4"
      aria-label="Előző kép"
    >
      <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      type="button"
      id="pg-lightbox-next"
      class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/10 p-2 text-white/90 transition-colors hover:bg-white/20 hover:text-white sm:right-4"
      aria-label="Következő kép"
    >
      <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <div class="flex h-full w-full flex-col items-center justify-center gap-4 overflow-hidden">
      <div id="pg-lightbox-viewport" class="flex max-h-[75vh] w-full flex-1 items-center justify-center overflow-hidden">
        <img
          id="pg-lightbox-img"
          src=""
          alt=""
          class="max-h-full max-w-full cursor-zoom-in select-none rounded-lg object-contain shadow-2xl transition-transform duration-300"
        />
      </div>

      <div id="pg-lightbox-thumbs" class="flex w-full max-w-full gap-2 overflow-x-auto px-2 pb-1">
        {safeImages.map((img, i) => (
          <button
            type="button"
            class="pg-thumb-btn shrink-0 overflow-hidden rounded-md border-2 border-transparent opacity-60 transition-opacity hover:opacity-100"
            data-thumb-index={i}
            aria-label={`${i + 1}. kép`}
          >
            <img
              src={img}
              alt=""
              loading="lazy"
              decoding="async"
              width="80"
              height="80"
              class="h-14 w-14 object-cover sm:h-16 sm:w-16"
            />
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script define:vars={{ safeImages, productName }}>
  (function () {
    const images = safeImages;
    const total = images.length;

    const openTriggers = document.querySelectorAll('[data-gallery-open]');
    const lightbox = document.getElementById('pg-lightbox');
    const lightboxImg = document.getElementById('pg-lightbox-img');
    const counter = document.getElementById('pg-lightbox-counter');
    const closeBtn = document.getElementById('pg-lightbox-close');
    const prevBtn = document.getElementById('pg-lightbox-prev');
    const nextBtn = document.getElementById('pg-lightbox-next');
    const thumbBtns = document.querySelectorAll('.pg-thumb-btn');
    const viewport = document.getElementById('pg-lightbox-viewport');

    if (!lightbox || !lightboxImg) return;

    let currentIndex = 0;
    let zoomed = false;
    let touchStartX = 0;
    let touchStartY = 0;

    function updateThumbActive() {
      thumbBtns.forEach((btn) => {
        const idx = Number(btn.getAttribute('data-thumb-index'));
        if (idx === currentIndex) {
          btn.classList.add('border-white', 'opacity-100');
          btn.classList.remove('border-transparent', 'opacity-60');
        } else {
          btn.classList.remove('border-white', 'opacity-100');
          btn.classList.add('border-transparent', 'opacity-60');
        }
      });
    }

    function showImage(index) {
      currentIndex = ((index % total) + total) % total;
      zoomed = false;
      lightboxImg.classList.remove('scale-[1.9]', 'cursor-zoom-out');
      lightboxImg.classList.add('cursor-zoom-in');
      lightboxImg.setAttribute('src', images[currentIndex]);
      lightboxImg.setAttribute('alt', `${productName} – kép ${currentIndex + 1}`);
      if (counter) counter.textContent = `${currentIndex + 1}/${total}`;
      updateThumbActive();
    }

    function openLightbox(index) {
      showImage(index);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.setAttribute('src', '');
      zoomed = false;
      document.body.style.overflow = '';
    }

    function next() {
      showImage(currentIndex + 1);
    }
    function prev() {
      showImage(currentIndex - 1);
    }

    function toggleZoom() {
      zoomed = !zoomed;
      if (zoomed) {
        lightboxImg.classList.add('scale-[1.9]', 'cursor-zoom-out');
        lightboxImg.classList.remove('cursor-zoom-in');
      } else {
        lightboxImg.classList.remove('scale-[1.9]', 'cursor-zoom-out');
        lightboxImg.classList.add('cursor-zoom-in');
      }
    }

    openTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const index = Number(trigger.getAttribute('data-index')) || 0;
        openLightbox(index);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      prev();
    });
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });

    lightboxImg.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleZoom();
    });

    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = Number(btn.getAttribute('data-thumb-index'));
        showImage(idx);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    if (viewport) {
      viewport.addEventListener(
        'touchstart',
        (e) => {
          const touch = e.touches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
        },
        { passive: true },
      );

      viewport.addEventListener(
        'touchend',
        (e) => {
          const touch = e.changedTouches[0];
          const deltaX = touch.clientX - touchStartX;
          const deltaY = touch.clientY - touchStartY;
          if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY)) {
            if (deltaX < 0) next();
            else prev();
          }
        },
        { passive: true },
      );
    }

    if (total <= 1) {
      prevBtn?.classList.add('hidden');
      nextBtn?.classList.add('hidden');
      if (counter) counter.classList.add('hidden');
    }
  })();
</script>
