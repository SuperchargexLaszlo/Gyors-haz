---
import type { Product } from '../lib/products';
import { formatAr, formatKulcsrakeszAr, formatM2, negyzetmeterAr } from '../lib/products';

interface Props {
  product: Product;
  featured?: boolean;
}

const { product, featured = false } = Astro.props;

const kategoriaNev: Record<Product['kategoria'], string> = {
  konnyuszerkezetes: 'Könnyűszerkezetes',
  modulhaz: 'Modulház',
  kontenerhoz: 'Konténerház',
};

const altSzoveg = `${product.nev} – ${formatM2(product.meret_m2)} m²${product.szobak > 0 ? `, ${product.szobak} szoba` : ''}${product.konyha ? ', konyha' : ''}${product.furdo > 0 ? `, ${product.furdo} fürdő` : ''} | Gyors Ház`;
---

<article
  class:list={[
    'group relative flex flex-col rounded-xl overflow-hidden bg-white shadow-sm transition-shadow hover:shadow-md',
    featured && 'ring-2 ring-accent',
  ]}
>
  <!-- Népszerű badge -->
  {featured && (
    <div class="absolute top-3 left-3 z-10 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-white shadow">
      Népszerű
    </div>
  )}

  <!-- Méret badge -->
  <div class="absolute top-3 right-3 z-10 rounded-full bg-primary/90 px-3 py-1 text-xs font-semibold text-white shadow">
    {formatM2(product.meret_m2)} m²
  </div>

  <!-- Kép -->
  <div class="aspect-[4/3] overflow-hidden bg-gray-100 relative">
    {product.kep === '/images/placeholder.webp' ? (
      <div class="h-full w-full flex flex-col items-center justify-center bg-gray-200 text-gray-500">
        <svg class="w-10 h-10 mb-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="text-xs font-medium">Kép hamarosan</span>
      </div>
    ) : (
      <img
        src={product.kep}
        alt={altSzoveg}
        loading="lazy"
        decoding="async"
        width="1200"
        height="800"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 cursor-zoom-in"
        data-zoomable
        data-fallback="/images/placeholder.webp"
      />
    )}
  </div>

  <!-- Tartalom -->
  <div class="flex flex-1 flex-col p-4">
    <p class="mb-1 text-xs font-medium uppercase tracking-wider text-gray-400">
      {kategoriaNev[product.kategoria]}
    </p>
    <h3 class="font-sans font-bold text-base text-gray-900 leading-snug mb-2">
      {product.nev}
    </h3>

    <!-- Ár -->
    {product.ar_kulcsrakesz_ft ? (
      <div class="mb-3 text-sm">
        <p class="font-sans text-gray-500">Alapár: <span class="font-bold text-lg text-primary">{formatAr(product)}</span></p>
        <p class="font-sans text-gray-500">Kulcsrakész: <span class="font-bold text-primary">{formatKulcsrakeszAr(product)}</span></p>
      </div>
    ) : (
      <p class="mb-3 font-sans font-bold text-lg text-primary">
        {formatAr(product)}
        <span class="ml-1 text-xs font-normal text-gray-400">{negyzetmeterAr(product)}</span>
      </p>
    )}

    <!-- Ikonok -->
    <div class="mb-4 flex flex-wrap gap-3 text-sm text-gray-600">
      <!-- Szobák -->
      {product.szobak > 0 && (<span class="flex items-center gap-1">
        <svg class="h-4 w-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>{product.szobak} szoba</span>
      </span>)}

      <!-- Fürdő -->
      {product.furdo > 0 && (<span class="flex items-center gap-1">
        <svg class="h-4 w-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>{product.furdo} fürdő</span>
      </span>)}

      <!-- Konyha -->
      {product.konyha && (
        <span class="flex items-center gap-1">
          <svg class="h-4 w-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>Konyha</span>
        </span>
      )}

      <!-- Terasz -->
      {product.terasz_m2 > 0 && (
        <span class="flex items-center gap-1">
          <svg class="h-4 w-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
          </svg>
          <span>{formatM2(product.terasz_m2)} m² terasz</span>
        </span>
      )}
    </div>

    <!-- CTA -->
    <div class="mt-auto">
      <a
        href={`/${product.kategoria}/${product.slug}`}
        class="block w-full rounded-lg border-2 border-primary px-4 py-2 text-center text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
      >
        Részletek →
      </a>
    </div>
  </div>
</article>
