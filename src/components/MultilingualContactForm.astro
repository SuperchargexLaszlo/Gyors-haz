---
interface Props {
  lang: string;
  formName: string;
}

const { lang, formName } = Astro.props;

interface Labels {
  name: string;
  phone: string;
  email: string;
  type: string;
  typeSelect: string;
  typeKsz: string;
  typeMod: string;
  typeKont: string;
  message: string;
  messagePlaceholder: string;
  submit: string;
  required: string;
  privacyNote: string;
}

const LABELS: Record<string, Labels> = {
  de: {
    name: 'Vollständiger Name',
    phone: 'Telefonnummer',
    email: 'E-Mail',
    type: 'Haustyp',
    typeSelect: 'Bitte wählen…',
    typeKsz: 'Fertighaus (Leichtbau)',
    typeMod: 'Modulhaus',
    typeKont: 'Containerhaus',
    message: 'Nachricht',
    messagePlaceholder: 'Erzählen Sie uns von Ihrem Projekt…',
    submit: 'Angebot anfordern',
    required: 'Pflichtfeld',
    privacyNote: 'Ihre Daten werden vertraulich behandelt.',
  },
  en: {
    name: 'Full Name',
    phone: 'Phone Number',
    email: 'Email',
    type: 'House Type',
    typeSelect: 'Please select…',
    typeKsz: 'Prefab House (Light Frame)',
    typeMod: 'Modular House',
    typeKont: 'Container House',
    message: 'Message',
    messagePlaceholder: 'Tell us about your project…',
    submit: 'Request a Quote',
    required: 'required',
    privacyNote: 'Your data is handled confidentially.',
  },
  sk: {
    name: 'Celé meno',
    phone: 'Telefónne číslo',
    email: 'E-mail',
    type: 'Typ domu',
    typeSelect: 'Vyberte…',
    typeKsz: 'Montovaný dom',
    typeMod: 'Modulárny dom',
    typeKont: 'Kontajnerový dom',
    message: 'Správa',
    messagePlaceholder: 'Povedzte nám o svojom projekte…',
    submit: 'Požiadať o ponuku',
    required: 'povinné',
    privacyNote: 'Vaše údaje spracúvame dôverne.',
  },
  ro: {
    name: 'Nume complet',
    phone: 'Număr de telefon',
    email: 'E-mail',
    type: 'Tipul casei',
    typeSelect: 'Selectați…',
    typeKsz: 'Casă prefabricată',
    typeMod: 'Casă modulară',
    typeKont: 'Casă container',
    message: 'Mesaj',
    messagePlaceholder: 'Spuneți-ne despre proiectul dumneavoastră…',
    submit: 'Solicitați ofertă',
    required: 'obligatoriu',
    privacyNote: 'Datele dumneavoastră sunt tratate confidențial.',
  },
  pl: {
    name: 'Imię i nazwisko',
    phone: 'Numer telefonu',
    email: 'E-mail',
    type: 'Typ domu',
    typeSelect: 'Wybierz…',
    typeKsz: 'Dom prefabrykowany',
    typeMod: 'Dom modułowy',
    typeKont: 'Domek kontenerowy',
    message: 'Wiadomość',
    messagePlaceholder: 'Opowiedz nam o swoim projekcie…',
    submit: 'Zapytaj o ofertę',
    required: 'wymagane',
    privacyNote: 'Twoje dane są traktowane poufnie.',
  },
  hr: {
    name: 'Puno ime',
    phone: 'Broj telefona',
    email: 'E-mail',
    type: 'Vrsta kuće',
    typeSelect: 'Odaberite…',
    typeKsz: 'Montažna kuća',
    typeMod: 'Modularna kuća',
    typeKont: 'Kontejnerska kuća',
    message: 'Poruka',
    messagePlaceholder: 'Recite nam nešto o svom projektu…',
    submit: 'Zatražite ponudu',
    required: 'obavezno',
    privacyNote: 'Vaši podaci obrađuju se povjerljivo.',
  },
};

const t = LABELS[lang] ?? LABELS.en!;

const nameId = `${formName}-name`;
const phoneId = `${formName}-phone`;
const emailId = `${formName}-email`;
const typeId = `${formName}-type`;
const messageId = `${formName}-message`;
---

<form
  name={formName}
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/koszonet"
  class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm space-y-5"
>
  <!-- Honeypot -->
  <p class="hidden">
    <label>Don't fill this out: <input name="bot-field" /></label>
  </p>
  <input type="hidden" name="form-name" value={formName} />
  <input type="hidden" name="language" value={lang} />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for={nameId} class="block text-sm font-medium text-gray-700 mb-1">
        {t.name} <span class="text-red-500" title={t.required}>*</span>
      </label>
      <input
        type="text"
        id={nameId}
        name="name"
        required
        autocomplete="name"
        class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
      />
    </div>

    <div>
      <label for={phoneId} class="block text-sm font-medium text-gray-700 mb-1">
        {t.phone} <span class="text-red-500" title={t.required}>*</span>
      </label>
      <input
        type="tel"
        id={phoneId}
        name="phone"
        required
        autocomplete="tel"
        class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
      />
    </div>
  </div>

  <div>
    <label for={emailId} class="block text-sm font-medium text-gray-700 mb-1">
      {t.email} <span class="text-red-500" title={t.required}>*</span>
    </label>
    <input
      type="email"
      id={emailId}
      name="email"
      required
      autocomplete="email"
      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
    />
  </div>

  <div>
    <label for={typeId} class="block text-sm font-medium text-gray-700 mb-1">
      {t.type}
    </label>
    <select
      id={typeId}
      name="type"
      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors bg-white"
    >
      <option value="">{t.typeSelect}</option>
      <option value="konnyuszerkezetes">{t.typeKsz}</option>
      <option value="modulhaz">{t.typeMod}</option>
      <option value="kontenerhaz">{t.typeKont}</option>
    </select>
  </div>

  <div>
    <label for={messageId} class="block text-sm font-medium text-gray-700 mb-1">
      {t.message}
    </label>
    <textarea
      id={messageId}
      name="message"
      rows="4"
      placeholder={t.messagePlaceholder}
      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors resize-y"
    ></textarea>
  </div>

  <div>
    <button
      type="submit"
      class="w-full rounded-xl bg-accent py-3.5 font-sans font-bold text-white text-base hover:bg-accent-dark transition-colors shadow"
    >
      {t.submit} →
    </button>
    <p class="mt-3 text-xs text-center text-gray-400">
      * {t.required} — {t.privacyNote}
    </p>
  </div>
</form>
