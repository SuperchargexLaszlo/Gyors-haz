---
import hazakData from '../data/hazak.json';

interface Haz {
  id: string;
  nev: string;
  kategoria: 'konnyuszerkezetes' | 'modulhaz' | 'kontenerhaz';
  slug: string;
  meret_m2: number;
  szobak: number;
  furdo: number;
  konyha: boolean;
  terasz_m2: number;
  ar_eur: number;
  ar_ft: number | null;
  afa: boolean;
  kep: string;
  leiras: string;
}

interface Props {
  kategoria?: Haz['kategoria'];
  slugok?: string[];
  columns?: 2 | 3 | 4;
}

const { kategoria, slugok, columns = 3 } = Astro.props;

const hazak = hazakData as Haz[];

let items: Haz[];
if (slugok && slugok.length > 0) {
  items = slugok
    .map((s) => hazak.find((h) => h.slug === s))
    .filter((h): h is Haz => Boolean(h));
} else if (kategoria) {
  items = hazak.filter((h) => h.kategoria === kategoria);
} else {
  items = hazak;
}

const kategoriaNev: Record<Haz['kategoria'], string> = {
  konnyuszerkezetes: 'Könnyűszerkezetes',
  modulhaz: 'Modulház',
  kontenerhaz: 'Konténerház',
};

const columnClasses: Record<2 | 3 | 4, string> = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};

function formatAr(h: Haz): string {
  if (h.ar_ft) {
    const szam = h.ar_ft.toLocaleString('hu-HU').replace(/\s/g, ' ');
    return h.afa ? `${szam} Ft + ÁFA` : `${szam} Ft`;
  }
  if (!h.ar_eur) return 'Ár: érdeklődjön!';
  const formatted = h.ar_eur.toLocaleString('hu-HU').replace(/\s/g, '.');
  return h.afa ? `${formatted} EUR + ÁFA` : `${formatted} EUR`;
}
---

<div class:list={['grid grid-cols-1 gap-5', columnClasses[columns]]}>
  {items.map((h) => (
    <article class="group relative flex flex-col rounded-xl overflow-hidden bg-white shadow-sm transition-shadow hover:shadow-md">
      <div class="absolute top-3 right-3 z-10 rounded-full bg-primary/90 px-3 py-1 text-xs font-semibold text-white shadow">
        {h.meret_m2} m²
      </div>

      <div class="aspect-[4/3] overflow-hidden bg-gray-100">
        <img
          src={h.kep}
          alt={`${h.nev} – ${h.meret_m2} m², ${h.szobak} szoba | Gyors Ház`}
          loading="lazy"
          decoding="async"
          width="1200"
          height="800"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          data-fallback="/images/placeholder.webp"
        />
      </div>

      <div class="flex flex-1 flex-col p-4">
        <p class="mb-1 text-xs font-medium uppercase tracking-wider text-gray-400">
          {kategoriaNev[h.kategoria]}
        </p>
        <h3 class="font-sans font-bold text-base text-gray-900 leading-snug mb-2">
          {h.nev}
        </h3>

        <p class="mb-3 font-sans font-bold text-lg text-primary">
          {formatAr(h)}
        </p>

        <div class="mb-4 flex flex-wrap gap-3 text-sm text-gray-600">
          <span>{h.szobak} szoba</span>
          <span>{h.furdo} fürdő</span>
          {h.konyha && <span>Konyha</span>}
          {h.terasz_m2 > 0 && <span>{h.terasz_m2} m² terasz</span>}
        </div>

        <div class="mt-auto">
          <a
            href={`/${h.kategoria}/${h.slug}`}
            class="block w-full rounded-lg border-2 border-primary px-4 py-2 text-center text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
          >
            Részletek →
          </a>
        </div>
      </div>
    </article>
  ))}
</div>
